---
---
<section data-animate class="bg-cream-dk py-4 px-3">
  <div class="grid grid-cols-2 lg:grid-cols-3 gap-2 lg:gap-3 h-[312px] lg:h-[440px]">
    <!-- Foto grande izquierda -->
    <div class="overflow-hidden rounded-lg row-span-2 lg:row-span-1">
      <img
        src="https://images.unsplash.com/photo-1606216794074-735e91aa2c92?w=900&auto=format&fit=crop&q=80"
        alt="Gustave & Sophie"
        class="w-full h-full object-cover object-center hover:scale-105 transition-transform duration-700"
        loading="lazy"
      />
    </div>
    <!-- Foto pequeña superior -->
    <div class="overflow-hidden rounded-lg h-[152px] lg:h-auto">
      <img
        src="https://images.unsplash.com/photo-1520854221256-17451cc331bf?w=600&auto=format&fit=crop&q=80"
        alt="Gustave & Sophie"
        class="w-full h-full object-cover hover:scale-105 transition-transform duration-700"
        loading="lazy"
      />
    </div>
    <!-- Foto pequeña inferior -->
    <div class="overflow-hidden rounded-lg h-[152px] lg:h-auto">
      <img
        src="https://images.unsplash.com/photo-1606800052052-a08af7148866?w=600&auto=format&fit=crop&q=80"
        alt="Gustave & Sophie"
        class="w-full h-full object-cover hover:scale-105 transition-transform duration-700"
        loading="lazy"
      />
    </div>
    <!-- Tercera foto — solo desktop -->
    <div class="hidden lg:block overflow-hidden rounded-lg">
      <img
        src="https://images.unsplash.com/photo-1583939003579-730e3918a45a?w=600&auto=format&fit=crop&q=80"
        alt="Gustave & Sophie"
        class="w-full h-full object-cover hover:scale-105 transition-transform duration-700"
        loading="lazy"
      />
    </div>
  </div>
</section>
