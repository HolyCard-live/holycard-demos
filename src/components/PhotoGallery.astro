---
---
<section data-animate class="bg-cream-dk py-4 px-3">
  <div class="grid grid-cols-2 gap-2" style="height: 312px;">
    <!-- Foto grande izquierda -->
    <div class="overflow-hidden rounded-lg row-span-2">
      <img
        src="https://images.unsplash.com/photo-1606216794074-735e91aa2c92?w=600&auto=format&fit=crop&q=80"
        alt="Gustave & Sophie"
        class="w-full h-full object-cover object-center hover:scale-105 transition-transform duration-700"
        loading="lazy"
      />
    </div>
    <!-- Foto pequeña superior -->
    <div class="overflow-hidden rounded-lg" style="height: 152px;">
      <img
        src="https://images.unsplash.com/photo-1520854221256-17451cc331bf?w=400&auto=format&fit=crop&q=80"
        alt="Gustave & Sophie"
        class="w-full h-full object-cover hover:scale-105 transition-transform duration-700"
        loading="lazy"
      />
    </div>
    <!-- Foto pequeña inferior -->
    <div class="overflow-hidden rounded-lg" style="height: 152px;">
      <img
        src="https://images.unsplash.com/photo-1606800052052-a08af7148866?w=400&auto=format&fit=crop&q=80"
        alt="Gustave & Sophie"
        class="w-full h-full object-cover hover:scale-105 transition-transform duration-700"
        loading="lazy"
      />
    </div>
  </div>
</section>
