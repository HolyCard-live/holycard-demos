---
---
<section data-animate class="py-14 px-8 bg-cream-dk text-center">
  <!-- Ícono música -->
  <div class="flex justify-center mb-4">
    <svg width="40" height="40" viewBox="0 0 40 40" fill="none" stroke="#6b8a50" stroke-width="1.5" stroke-linecap="round">
      <circle cx="12" cy="32" r="5"/>
      <circle cx="32" cy="28" r="5"/>
      <polyline points="17 32 17 10 37 6 37 28"/>
      <line x1="17" y1="10" x2="37" y2="6"/>
    </svg>
  </div>

  <h3 class="text-base lg:text-lg tracking-[0.35em] uppercase text-bot-dark font-semibold mb-4">Playlist colaborativa</h3>
  <p class="font-serif italic text-bot-mid text-lg lg:text-xl mb-8 max-w-xs mx-auto">
    La fiesta la hacen todos. Sugerirnos esa canción que no puede faltar.
  </p>

  <div class="max-w-xs mx-auto">
    <input
      type="text"
      placeholder="Nombre de la canción..."
      class="w-full border-b border-bot-mid bg-transparent text-center text-sm text-bot-dark py-2 outline-none placeholder:text-bot-mid/40 font-serif italic mb-4"
      disabled
    />
    <button class="border border-bot-mid text-bot-mid text-sm lg:text-base tracking-[0.25em] uppercase py-2.5 px-8 rounded-full hover:bg-bot-mid hover:text-white transition-colors">
      Sugerir canción
    </button>
  </div>
</section>
