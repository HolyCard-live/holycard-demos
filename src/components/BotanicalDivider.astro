---
interface Props {
  variant?: 'branch' | 'leaves' | 'dots';
  bg?: string;
}
const { variant = 'branch', bg } = Astro.props;
const bgStyle = bg ? `background-color: ${bg};` : '';
---

{variant === 'branch' && (
  <div class="flex justify-center py-4" style={bgStyle} aria-hidden="true">
    <svg width="220" height="54" viewBox="0 0 220 54" fill="none" style="opacity: 0.65">
      <!-- Rama principal -->
      <path d="M10 27 Q55 10 110 27 Q165 44 210 27" stroke="#8aab8b" stroke-width="1.2" fill="none"/>
      <!-- Rama secundaria superior -->
      <path d="M60 20 Q80 12 95 18" stroke="#a8bf8c" stroke-width="0.8" fill="none"/>
      <path d="M125 18 Q140 12 160 20" stroke="#a8bf8c" stroke-width="0.8" fill="none"/>
      <!-- Hojas izquierda -->
      <ellipse cx="38" cy="17" rx="16" ry="6.5" transform="rotate(-25 38 17)" fill="#a8bf8c"/>
      <path d="M38 17 Q44 20 50 16" stroke="#8aab8b" stroke-width="0.6" fill="none" opacity="0.6"/>
      <ellipse cx="68" cy="14" rx="13" ry="5.5" transform="rotate(-38 68 14)" fill="#8aab8b"/>
      <path d="M68 14 Q73 16 78 13" stroke="#6b8a50" stroke-width="0.5" fill="none" opacity="0.6"/>
      <!-- Hojas derecha -->
      <ellipse cx="152" cy="36" rx="15" ry="6" transform="rotate(22 152 36)" fill="#a8bf8c"/>
      <path d="M152 36 Q158 33 163 36" stroke="#8aab8b" stroke-width="0.6" fill="none" opacity="0.6"/>
      <ellipse cx="182" cy="30" rx="12" ry="5" transform="rotate(30 182 30)" fill="#8aab8b"/>
      <!-- Centro floral -->
      <circle cx="110" cy="27" r="3" fill="#6b8a50"/>
      <path d="M110 27 L110 16" stroke="#6b8a50" stroke-width="0.9"/>
      <ellipse cx="110" cy="13.5" rx="7" ry="3.5" transform="rotate(-8 110 13.5)" fill="#6b8a50" opacity="0.75"/>
      <path d="M110 13.5 Q114 15 117 12" stroke="#2d3d20" stroke-width="0.5" fill="none" opacity="0.5"/>
      <!-- Hojitas pequeñas extra -->
      <ellipse cx="90" cy="22" rx="8" ry="3.5" transform="rotate(-15 90 22)" fill="#a8bf8c" opacity="0.6"/>
      <ellipse cx="130" cy="22" rx="8" ry="3.5" transform="rotate(15 130 22)" fill="#a8bf8c" opacity="0.6"/>
    </svg>
  </div>
)}

{variant === 'leaves' && (
  <div class="py-4" style={bgStyle} aria-hidden="true">
    <div class="flex justify-center items-center gap-4" style="opacity: 0.55">
    <!-- Hoja pequeña izquierda -->
    <svg width="18" height="24" viewBox="0 0 18 24">
      <path d="M9 22 Q1 15 3 4 Q13 2 17 11 Q15 19 9 22Z" fill="#a8bf8c"/>
      <path d="M9 22 L9 4" stroke="#6b8a50" stroke-width="0.8" fill="none"/>
      <path d="M9 14 Q12 12 15 13" stroke="#6b8a50" stroke-width="0.5" fill="none" opacity="0.5"/>
    </svg>
    <!-- Punto separador -->
    <svg width="6" height="6" viewBox="0 0 6 6"><circle cx="3" cy="3" r="2" fill="#8aab8b"/></svg>
    <!-- Hoja grande central izquierda -->
    <svg width="22" height="30" viewBox="0 0 22 30">
      <path d="M11 28 Q1 18 4 4 Q15 1 21 12 Q18 23 11 28Z" fill="#6b8a50"/>
      <path d="M11 28 L11 4" stroke="#2d3d20" stroke-width="0.9" fill="none"/>
      <path d="M11 20 Q15 17 18 19" stroke="#2d3d20" stroke-width="0.5" fill="none" opacity="0.5"/>
      <path d="M11 13 Q14 10 17 12" stroke="#2d3d20" stroke-width="0.5" fill="none" opacity="0.4"/>
    </svg>
    <!-- Elemento central -->
    <svg width="14" height="20" viewBox="0 0 14 20">
      <circle cx="7" cy="7" r="3" fill="#6b8a50" opacity="0.8"/>
      <path d="M7 10 L7 20" stroke="#8aab8b" stroke-width="0.8" fill="none"/>
      <ellipse cx="4" cy="15" rx="4" ry="2" transform="rotate(-20 4 15)" fill="#a8bf8c" opacity="0.6"/>
      <ellipse cx="10" cy="15" rx="4" ry="2" transform="rotate(20 10 15)" fill="#a8bf8c" opacity="0.6"/>
    </svg>
    <!-- Hoja grande central derecha (espejo) -->
    <svg width="22" height="30" viewBox="0 0 22 30" style="transform: scaleX(-1)">
      <path d="M11 28 Q1 18 4 4 Q15 1 21 12 Q18 23 11 28Z" fill="#6b8a50"/>
      <path d="M11 28 L11 4" stroke="#2d3d20" stroke-width="0.9" fill="none"/>
      <path d="M11 20 Q15 17 18 19" stroke="#2d3d20" stroke-width="0.5" fill="none" opacity="0.5"/>
      <path d="M11 13 Q14 10 17 12" stroke="#2d3d20" stroke-width="0.5" fill="none" opacity="0.4"/>
    </svg>
    <!-- Punto separador -->
    <svg width="6" height="6" viewBox="0 0 6 6"><circle cx="3" cy="3" r="2" fill="#8aab8b"/></svg>
    <!-- Hoja pequeña derecha (espejo) -->
    <svg width="18" height="24" viewBox="0 0 18 24" style="transform: scaleX(-1)">
      <path d="M9 22 Q1 15 3 4 Q13 2 17 11 Q15 19 9 22Z" fill="#a8bf8c"/>
      <path d="M9 22 L9 4" stroke="#6b8a50" stroke-width="0.8" fill="none"/>
      <path d="M9 14 Q12 12 15 13" stroke="#6b8a50" stroke-width="0.5" fill="none" opacity="0.5"/>
    </svg>
    </div>
  </div>
)}

{variant === 'dots' && (
  <div class="flex justify-center items-center py-5" style={bgStyle} aria-hidden="true">
    <svg width="160" height="16" viewBox="0 0 160 16" fill="none" style="opacity: 0.50">
      <!-- Línea izquierda -->
      <line x1="4" y1="8" x2="58" y2="8" stroke="#c8b89a" stroke-width="0.8"/>
      <!-- Puntos graduados izquierda -->
      <circle cx="62" cy="8" r="1.5" fill="#8aab8b"/>
      <circle cx="70" cy="8" r="2" fill="#6b8a50"/>
      <!-- Rombo central -->
      <path d="M80 3 L84 8 L80 13 L76 8 Z" fill="#6b8a50"/>
      <!-- Puntos graduados derecha -->
      <circle cx="90" cy="8" r="2" fill="#6b8a50"/>
      <circle cx="98" cy="8" r="1.5" fill="#8aab8b"/>
      <!-- Línea derecha -->
      <line x1="102" y1="8" x2="156" y2="8" stroke="#c8b89a" stroke-width="0.8"/>
    </svg>
  </div>
)}
