---
import { Church, Camera, UtensilsCrossed, Wine, Music2, PartyPopper } from '@lucide/astro';
---
<section data-animate class="timeline-section py-16 px-6 bg-cream-dk">
  <h3 class="text-[10px] tracking-[0.45em] uppercase text-bot-dark font-semibold text-center mb-10">Itinerario</h3>

  <div class="relative max-w-xs mx-auto">
    <!-- Línea vertical -->
    <div class="absolute left-5 top-3 bottom-3 w-px bg-tan/40"></div>

    <ul class="space-y-8">

      <li class="timeline-item flex items-start gap-5">
        <div class="relative flex-shrink-0 w-10 h-10 bg-bot-dark rounded-full flex items-center justify-center shadow-sm">
          <Church size={17} stroke-width={1.5} class="text-white" />
        </div>
        <div class="pt-1.5">
          <p class="text-[10px] text-bot-mid tracking-widest uppercase">18:00</p>
          <p class="font-serif text-bot-dark text-base font-medium">Ceremonia</p>
        </div>
      </li>

      <li class="timeline-item flex items-start gap-5">
        <div class="relative flex-shrink-0 w-10 h-10 bg-bot-mid rounded-full flex items-center justify-center shadow-sm">
          <Camera size={17} stroke-width={1.5} class="text-white" />
        </div>
        <div class="pt-1.5">
          <p class="text-[10px] text-bot-mid tracking-widest uppercase">19:30</p>
          <p class="font-serif text-bot-dark text-base font-medium">Sesión de fotos</p>
        </div>
      </li>

      <li class="timeline-item flex items-start gap-5">
        <div class="relative flex-shrink-0 w-10 h-10 bg-bot-dark rounded-full flex items-center justify-center shadow-sm">
          <UtensilsCrossed size={17} stroke-width={1.5} class="text-white" />
        </div>
        <div class="pt-1.5">
          <p class="text-[10px] text-bot-mid tracking-widest uppercase">20:00</p>
          <p class="font-serif text-bot-dark text-base font-medium">Cena</p>
        </div>
      </li>

      <li class="timeline-item flex items-start gap-5">
        <div class="relative flex-shrink-0 w-10 h-10 bg-bot-mid rounded-full flex items-center justify-center shadow-sm">
          <Wine size={17} stroke-width={1.5} class="text-white" />
        </div>
        <div class="pt-1.5">
          <p class="text-[10px] text-bot-mid tracking-widest uppercase">21:00</p>
          <p class="font-serif text-bot-dark text-base font-medium">Brindis</p>
        </div>
      </li>

      <li class="timeline-item flex items-start gap-5">
        <div class="relative flex-shrink-0 w-10 h-10 bg-bot-dark rounded-full flex items-center justify-center shadow-sm">
          <Music2 size={17} stroke-width={1.5} class="text-white" />
        </div>
        <div class="pt-1.5">
          <p class="text-[10px] text-bot-mid tracking-widest uppercase">21:30</p>
          <p class="font-serif text-bot-dark text-base font-medium">Primer baile</p>
        </div>
      </li>

      <li class="timeline-item flex items-start gap-5">
        <div class="relative flex-shrink-0 w-10 h-10 bg-bot-mid rounded-full flex items-center justify-center shadow-sm">
          <PartyPopper size={17} stroke-width={1.5} class="text-white" />
        </div>
        <div class="pt-1.5">
          <p class="text-[10px] text-bot-mid tracking-widest uppercase">23:00</p>
          <p class="font-serif text-bot-dark text-base font-medium">Fiesta</p>
        </div>
      </li>

    </ul>
  </div>
</section>
