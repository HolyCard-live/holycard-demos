---
import { Gift, ShoppingBag, Mail, CreditCard } from '@lucide/astro';
---
<section data-animate class="py-16 px-6 bg-cream-dk text-center">

  <div class="flex justify-center mb-4">
    <Gift size={40} stroke-width={1} class="text-bot-mid" />
  </div>

  <h3 class="text-sm lg:text-base tracking-[0.45em] uppercase text-bot-dark font-semibold mb-4">Sugerencia de regalos</h3>
  <p class="font-serif italic text-bot-mid text-lg lg:text-xl mb-8 max-w-xs lg:max-w-sm mx-auto">
    Su presencia es el mejor regalo. Si desean tener un detalle con nosotros, les dejamos estas opciones:
  </p>

  <div class="space-y-4 max-w-xs mx-auto lg:space-y-0 lg:grid lg:grid-cols-3 lg:gap-5 lg:max-w-none">

    <div class="bg-cream rounded-xl p-4 text-left flex items-center gap-4 shadow-sm border border-tan/20">
      <div class="flex-shrink-0 w-9 h-9 bg-bot-pale/40 rounded-full flex items-center justify-center text-bot-dark">
        <ShoppingBag size={17} stroke-width={1.5} />
      </div>
      <div>
        <p class="text-base lg:text-lg font-semibold text-bot-dark tracking-wide uppercase">Mesa de regalos</p>
        <p class="text-base lg:text-lg text-bot-mid mt-0.5">Tienda · Número de mesa: XXXX</p>
      </div>
    </div>

    <div class="bg-cream rounded-xl p-4 text-left flex items-center gap-4 shadow-sm border border-tan/20">
      <div class="flex-shrink-0 w-9 h-9 bg-bot-pale/40 rounded-full flex items-center justify-center text-bot-dark">
        <Mail size={17} stroke-width={1.5} />
      </div>
      <div>
        <p class="text-base lg:text-lg font-semibold text-bot-dark tracking-wide uppercase">Lluvia de sobres</p>
        <p class="text-base lg:text-lg text-bot-mid mt-0.5">Pueden entregarlo el día del evento</p>
      </div>
    </div>

    <div class="bg-cream rounded-xl p-4 text-left flex items-center gap-4 shadow-sm border border-tan/20">
      <div class="flex-shrink-0 w-9 h-9 bg-bot-pale/40 rounded-full flex items-center justify-center text-bot-dark">
        <CreditCard size={17} stroke-width={1.5} />
      </div>
      <div>
        <p class="text-base lg:text-lg font-semibold text-bot-dark tracking-wide uppercase">Transferencia</p>
        <p class="text-base lg:text-lg text-bot-mid mt-0.5">Cuenta: XXXX · CBU: XXXX</p>
      </div>
    </div>

  </div>
</section>
