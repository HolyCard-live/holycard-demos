<section data-animate class="py-14 px-10 text-center bg-cream">
  <!-- Hoja decorativa pequeña -->
  <div class="flex justify-center mb-6">
    <svg width="40" height="40" viewBox="0 0 40 40" fill="none">
      <path d="M20 36 Q8 24 12 8 Q24 4 32 16 Q28 28 20 36Z" fill="#a8bf8c" opacity="0.6"/>
      <path d="M20 36 Q20 20 20 8" stroke="#6b8a50" stroke-width="1" fill="none" opacity="0.5"/>
    </svg>
  </div>

  <blockquote class="font-serif italic text-2xl lg:text-3xl text-bot-dark leading-relaxed max-w-sm mx-auto">
    "Ya no son dos, sino uno solo. Por tanto, lo que Dios ha unido, que no lo separe el hombre."
  </blockquote>

  <div class="w-10 border-t border-bot-mid mx-auto my-5"></div>

  <cite class="text-base lg:text-lg text-bot-mid tracking-[0.25em] uppercase not-italic">
    Mateo 19:6
  </cite>
</section>
