---
interface Props {
  title?: string;
}
const { title = 'Gustave & Sophie — 17 · Feb · 2027' } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- SEO & Open Graph -->
    <meta name="description" content="Nos casamos y queremos celebrar contigo — 17 de Febrero 2027" />
    <meta property="og:title" content="Gustave & Sophie — 17 · Feb · 2027" />
    <meta property="og:description" content="Con todo nuestro amor, te invitamos a celebrar el día más especial de nuestras vidas." />
    <meta property="og:image" content="https://images.unsplash.com/photo-1519741497674-611481863552?w=1200&auto=format&fit=crop&q=80" />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#f7f4ed" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Great+Vibes&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-cream font-serif antialiased">

    <!-- Scroll progress bar -->
    <div
      id="scroll-progress"
      class="fixed top-0 left-0 h-[2px] bg-bot-mid z-50 origin-left"
      style="width: 100%; transform: scaleX(0);"
      aria-hidden="true"
    ></div>

    <!-- Splash overlay -->
    <div
      id="splash"
      class="fixed inset-0 z-[100] flex flex-col items-center justify-center px-6"
      style="background-color: #ede8de;"
      aria-hidden="true"
    >
      <!--
        ARQUITECTURA FINAL DEL SOBRE:
        El sobre es UN SOLO contenedor rectangular con fondo beige.
        El flap es un div abs encima (z:3), cubre el top del sobre.
        La tarjeta está dentro con márgenes (papel beige visible en lados).
        El flap CUBRE la parte superior de la tarjeta → efecto "sellado".
        Al animar: flap gira hacia arriba revelando la tarjeta completa.
      -->
      <div id="splash-envelope-wrap" style="
        position: relative;
        width: min(82vw, 270px);
        background-color: #c8c0ae;
        border: 1px solid #b5a87d;
        box-shadow: 0 16px 52px rgba(0,0,0,0.22), 0 4px 12px rgba(0,0,0,0.10);
        perspective: 1200px;
      ">

        <!-- TARJETA: papel crema dentro del sobre, márgenes muestran el papel del sobre -->
        <div id="splash-card" style="
          background-color: #faf7f2;
          margin: 16px 16px 10px;
          min-height: 280px;
          position: relative;
          z-index: 1;
          box-shadow: 0 2px 16px rgba(0,0,0,0.13);
          display: flex;
          flex-direction: column;
          align-items: center;
          justify-content: center;
          text-align: center;
          padding: 2.25rem 1.5rem;
          -webkit-font-smoothing: antialiased;
          -moz-osx-font-smoothing: grayscale;
        ">
          <!-- Ornamento superior -->
          <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 1.4rem; opacity: 0.45;">
            <div style="width: 32px; height: 1px; background-color: #8aab8b;"></div>
            <div style="width: 5px; height: 5px; background-color: #6b8a50; transform: rotate(45deg);"></div>
            <div style="width: 32px; height: 1px; background-color: #8aab8b;"></div>
          </div>
          <p style="font-family: 'Cormorant Garamond', serif; font-size: 10px; letter-spacing: 0.28em; text-transform: uppercase; color: #4d6838; margin-bottom: 1rem; font-weight: 400;">Con todo nuestro amor</p>
          <h1 style="font-family: 'Great Vibes', cursive; font-size: 4rem; color: #2d3d20; line-height: 1.05; margin-bottom: 0.9rem;">G &amp; S</h1>
          <div style="width: 30px; height: 1px; background-color: #c8b89a; margin: 0 auto 0.9rem;"></div>
          <p style="font-family: 'Cormorant Garamond', serif; font-size: 10.5px; letter-spacing: 0.22em; text-transform: uppercase; color: #3d4e2a; font-weight: 400;">17 · Febrero · 2027</p>
        </div>

        <!-- BASE DEL SOBRE: franja visible debajo de la tarjeta con pliegues en V -->
        <div style="height: 44px; position: relative;">
          <svg style="position: absolute; inset: 0; width: 100%; height: 100%;"
               viewBox="0 0 270 44" preserveAspectRatio="none" fill="none">
            <line x1="0"   y1="44" x2="135" y2="4" stroke="#b5a87d" stroke-width="0.9" opacity="0.55"/>
            <line x1="270" y1="44" x2="135" y2="4" stroke="#b5a87d" stroke-width="0.9" opacity="0.55"/>
          </svg>
        </div>

        <!-- FLAP: cubre el top del sobre (incluyendo la parte superior de la tarjeta) -->
        <!-- En estado sellado: el flap cubre ~100px → top ~85px de la tarjeta oculto -->
        <!-- Al animar: rotateX(-170deg) revela la tarjeta completa                  -->
        <div id="splash-flap"
             style="
               position: absolute;
               top: -1px; left: -1px; right: -1px;
               height: 106px;
               transform-origin: top center;
               z-index: 3;
             "
             aria-hidden="true">
          <svg width="100%" height="106" viewBox="0 0 272 106" preserveAspectRatio="none" fill="none">
            <!-- Flap: triángulo descendente que cubre el borde del sobre -->
            <path d="M0 0 L272 0 L272 1 L136 104 L0 1 Z" fill="#cdc6b8"/>
            <!-- Línea de sellado: el pliegue del flap -->
            <path d="M0 1 L136 104 L272 1" stroke="#a89870" stroke-width="1.4" fill="none" opacity="0.9"/>
          </svg>
        </div>

        <!-- SELLO DE CERA: centrado exactamente en la punta del flap -->
        <div id="splash-seal" style="
          position: absolute;
          top: 87px;
          left: 50%;
          transform: translateX(-50%);
          width: 36px; height: 36px;
          background-color: #2d3d20;
          border-radius: 50%;
          display: flex; align-items: center; justify-content: center;
          box-shadow: 0 2px 8px rgba(0,0,0,0.35);
          z-index: 10;
        ">
          <span style="font-family: 'Great Vibes', cursive; color: #f7f4ed; font-size: 14px; line-height: 1; -webkit-font-smoothing: antialiased;">G</span>
        </div>

      </div>

      <!-- CTA claro y con contraste -->
      <button
        id="splash-cta"
        style="margin-top: 2.5rem; display: flex; align-items: center; gap: 8px; background-color: #2d3d20; color: #f7f4ed; border: none; padding: 0.75rem 1.75rem; border-radius: 999px; cursor: pointer; font-family: 'Cormorant Garamond', serif; font-size: 12px; letter-spacing: 0.25em; text-transform: uppercase;"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
          <polyline points="22,6 12,13 2,6"/>
        </svg>
        Abrir invitación
      </button>

    </div>

    <!-- Sticky mini header -->
    <header
      id="sticky-header"
      class="fixed top-0 left-1/2 -translate-x-1/2 w-full max-w-lg z-40 bg-cream/90 backdrop-blur-sm border-b border-bot-light/20 px-6 py-3 flex items-center justify-between opacity-0 pointer-events-none transition-opacity duration-300"
      aria-hidden="true"
    >
      <div class="w-8 border-t border-bot-mid/40"></div>
      <p class="font-script text-xl text-bot-dark">Gustave &amp; Sophie</p>
      <p class="text-[9px] tracking-[0.2em] text-bot-mid/60 uppercase">17·02·2027</p>
    </header>

    <main class="max-w-lg mx-auto min-h-screen shadow-2xl overflow-hidden">
      <slot />
    </main>

    <script>
      import Lenis from 'lenis';
      const lenis = new Lenis({
        duration: 1.2,
        easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
      });
      function raf(time: number) {
        lenis.raf(time);
        requestAnimationFrame(raf);
      }
      requestAnimationFrame(raf);

      // Scroll progress bar
      const progressBar = document.getElementById('scroll-progress');
      if (progressBar) {
        window.addEventListener('scroll', () => {
          const scrollTop = window.scrollY;
          const docHeight = document.documentElement.scrollHeight - window.innerHeight;
          const progress = docHeight > 0 ? scrollTop / docHeight : 0;
          progressBar.style.transform = `scaleX(${progress})`;
        }, { passive: true });
      }

      // Splash — envelope opening effect
      const splash = document.getElementById('splash');
      const splashCta = document.getElementById('splash-cta');
      if (splash) {
        document.body.style.overflow = 'hidden';

        let dismissed = false;
        const dismissSplash = () => {
          if (dismissed) return;
          dismissed = true;

          const g = (window as any).__gsap;
          const flap = document.getElementById('splash-flap');
          const wrap = document.getElementById('splash-envelope-wrap');

          if (g && flap && wrap) {
            const tl = g.timeline({
              onComplete: () => {
                splash.style.display = 'none';
                document.body.style.overflow = '';
              },
            });
            // 1. Sello y botón desaparecen juntos antes de abrir el sobre
            tl.to('#splash-seal', {
              scale: 0, opacity: 0, duration: 0.38, ease: 'back.in(1.8)',
            });
            tl.to('#splash-cta', {
              opacity: 0, y: 8, duration: 0.3, ease: 'power2.in',
            }, '<');
            // 2. Flap se abre hacia arriba suavemente
            tl.to(flap, {
              rotateX: -175,
              duration: 0.9,
              ease: 'power2.inOut',
            }, '+=0.06');
            // 3. Sobre sube y se desvanece
            tl.to(wrap, {
              y: 22,
              opacity: 0,
              duration: 0.55,
              ease: 'power3.in',
            }, '-=0.2');
            // 4. Overlay se cierra
            tl.to(splash, {
              opacity: 0,
              duration: 0.4,
              ease: 'power2.in',
            }, '-=0.3');
          } else {
            splash.style.transition = 'opacity 0.5s ease';
            splash.style.opacity = '0';
            setTimeout(() => {
              splash.style.display = 'none';
              document.body.style.overflow = '';
            }, 500);
          }
        };

        splash.addEventListener('click', dismissSplash);
        if (splashCta) splashCta.addEventListener('click', dismissSplash);
      }

      // Sticky header
      const stickyHeader = document.getElementById('sticky-header');
      if (stickyHeader) {
        const heroSection = document.querySelector('section');
        const observer = new IntersectionObserver(
          ([entry]) => {
            const visible = !entry.isIntersecting;
            stickyHeader.style.opacity = visible ? '1' : '0';
            stickyHeader.style.pointerEvents = visible ? 'auto' : 'none';
            stickyHeader.setAttribute('aria-hidden', String(!visible));
          },
          { threshold: 0.1 }
        );
        if (heroSection) observer.observe(heroSection);
      }
    </script>
  </body>
</html>

<style is:global>
  html { scroll-behavior: auto; }
  body { background-color: #f7f4ed; }
</style>
