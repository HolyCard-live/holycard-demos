  },
  {
    slug: 'cottagecore-etereo',
    title: 'Cottagecore Etéreo',
    couple: 'Joaquín & Lucía',
    location: 'Valle de Guadalupe, BC',
    date: '17 · Julio · 2027',
    style: 'Pastoral · Viñedo',
    palette: ['#b8a4c9', '#f5e6a8', '#a8c4a2'],
    image: 'https://images.unsplash.com/photo-1464366400600-7168b8af9bc3?w=1200&auto=format&fit=crop&q=80',
    description: 'Pastel onírico entre viñedos. Flores silvestres, luces tibias y romance suave.',
  },
