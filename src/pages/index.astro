---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Holycard — Galería de Demos</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content="Showcase de 8 invitaciones digitales de boda. Cada demo, un universo distinto." />
    <meta name="theme-color" content="#0e0e0e" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500&family=Inter:wght@300;400;500;600&family=Italiana&display=swap" rel="stylesheet" />
  </head>
  <body>
    <main class="page">

      <header class="hero">
        <div class="hero-inner">
          <p class="kicker">Holycard · Showcase 2027</p>
          <h1>Ocho universos.<br/><em>Una sola promesa.</em></h1>
          <p class="lede">
            Invitaciones digitales que no se parecen a nada que hayas visto. Cada demo es un mundo cerrado:
            tipografía, color, ritmo y emoción afinados al mismo tono. Selecciona una y entra.
          </p>
          <div class="hero-meta">
            <span>8 estilos</span>
            <span>·</span>
            <span>15 secciones por demo</span>
            <span>·</span>
            <span>2027</span>
          </div>
        </div>
        <div class="hero-rule" aria-hidden="true"></div>
      </header>

      <section class="grid">
        {demos.map((d, i) => (
          <a class="card" href={`/demos/${d.slug}`} data-card>
            <div class="card-media">
              <img src={d.image} alt={d.title} loading="lazy" />
              <div class="card-overlay"></div>
              <div class="card-palette" aria-hidden="true">
                {d.palette.map(c => (<span style={`background:${c}`}></span>))}
              </div>
            </div>
            <div class="card-body">
              <p class="card-num">{String(i + 1).padStart(2, '0')}</p>
              <p class="card-style">{d.style}</p>
              <h2>{d.title}</h2>
              <p class="card-couple">{d.couple}</p>
              <p class="card-meta">{d.location} · {d.date}</p>
              <p class="card-desc">{d.description}</p>
              <span class="card-cta">Abrir invitación →</span>
            </div>
          </a>
        ))}
      </section>

      <section class="legacy">
        <div class="legacy-inner">
          <p class="kicker">Demo legacy</p>
          <h2>Gustave & Sophie <em>· Botánico</em></h2>
          <p>El primer experimento. Verdes salvia, caligrafía romántica y partículas vivas en el viento.</p>
          <a href="/invitacion-original">Ver demo original →</a>
        </div>
      </section>

      <footer class="foot">
        <p>Holycard · 2027 · Hecho con cariño y código.</p>
      </footer>

    </main>

    <script>
      const cards = document.querySelectorAll<HTMLElement>('[data-card]');
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add('in');
            io.unobserve(e.target);
          }
        }
      }, { threshold: 0.1 });
      cards.forEach(c => io.observe(c));
    </script>

    <style is:global>
      :root {
        --bg: #0e0e0e;
        --bg-soft: #161616;
        --fg: #f4f1ec;
        --fg-mid: #a3a09a;
        --accent: #c9a961;
        --rule: rgba(244,241,236,0.12);
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; background: var(--bg); color: var(--fg); }
      body {
        font-family: 'Inter', system-ui, sans-serif;
        font-weight: 300;
        -webkit-font-smoothing: antialiased;
      }
      img { display: block; max-width: 100%; }
      a { color: inherit; text-decoration: none; }
      .page { min-height: 100vh; }

      .hero {
        padding: 96px 24px 64px;
        max-width: 1280px;
        margin: 0 auto;
      }
      @media (min-width: 768px) { .hero { padding: 140px 48px 80px; } }
      .hero-inner { max-width: 880px; }
      .kicker {
        font-size: 11px;
        letter-spacing: 0.32em;
        text-transform: uppercase;
        color: var(--accent);
        margin: 0 0 20px;
      }
      .hero h1 {
        font-family: 'Italiana', serif;
        font-weight: 400;
        font-size: clamp(48px, 9vw, 128px);
        line-height: 0.95;
        margin: 0 0 32px;
        letter-spacing: -0.01em;
      }
      .hero h1 em {
        font-family: 'Cormorant Garamond', serif;
        font-style: italic;
        font-weight: 300;
        color: var(--fg-mid);
      }
      .lede {
        font-family: 'Cormorant Garamond', serif;
        font-size: clamp(18px, 2vw, 22px);
        line-height: 1.55;
        color: var(--fg-mid);
        max-width: 640px;
        margin: 0 0 28px;
      }
      .hero-meta {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        font-size: 11px;
        letter-spacing: 0.28em;
        text-transform: uppercase;
        color: var(--fg-mid);
      }
      .hero-rule {
        margin: 64px 0 0;
        height: 1px;
        background: var(--rule);
      }

      .grid {
        max-width: 1280px;
        margin: 0 auto;
        padding: 64px 24px;
        display: grid;
        gap: 56px;
      }
      @media (min-width: 768px) {
        .grid {
          grid-template-columns: repeat(2, 1fr);
          gap: 80px 56px;
          padding: 96px 48px;
        }
      }

      .card {
        display: block;
        position: relative;
        opacity: 0;
        transform: translateY(40px);
        transition: opacity 0.9s ease, transform 0.9s ease;
      }
      .card.in { opacity: 1; transform: translateY(0); }
      .card-media {
        position: relative;
        aspect-ratio: 4 / 5;
        overflow: hidden;
        background: var(--bg-soft);
      }
      .card-media img {
        width: 100%; height: 100%;
        object-fit: cover;
        transition: transform 1.4s ease;
        filter: saturate(0.9);
      }
      .card:hover .card-media img { transform: scale(1.06); }
      .card-overlay {
        position: absolute; inset: 0;
        background: linear-gradient(to top, rgba(14,14,14,0.45), transparent 50%);
      }
      .card-palette {
        position: absolute;
        bottom: 16px; left: 16px;
        display: flex; gap: 6px;
      }
      .card-palette span {
        width: 18px; height: 18px;
        border-radius: 50%;
        border: 1px solid rgba(255,255,255,0.3);
      }
      .card-body {
        padding: 24px 0 0;
        position: relative;
      }
      .card-num {
        position: absolute;
        top: 24px; right: 0;
        font-family: 'Italiana', serif;
        font-size: 16px;
        color: var(--fg-mid);
        margin: 0;
      }
      .card-style {
        font-size: 11px;
        letter-spacing: 0.28em;
        text-transform: uppercase;
        color: var(--accent);
        margin: 0 0 12px;
      }
      .card h2 {
        font-family: 'Italiana', serif;
        font-weight: 400;
        font-size: clamp(28px, 3.6vw, 44px);
        line-height: 1;
        margin: 0 0 14px;
        letter-spacing: -0.005em;
      }
      .card-couple {
        font-family: 'Cormorant Garamond', serif;
        font-style: italic;
        font-size: 20px;
        margin: 0 0 6px;
        color: var(--fg);
      }
      .card-meta {
        font-size: 12px;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--fg-mid);
        margin: 0 0 18px;
      }
      .card-desc {
        font-family: 'Cormorant Garamond', serif;
        font-size: 17px;
        line-height: 1.5;
        color: var(--fg-mid);
        margin: 0 0 20px;
        max-width: 480px;
      }
      .card-cta {
        font-size: 12px;
        letter-spacing: 0.24em;
        text-transform: uppercase;
        color: var(--accent);
        border-bottom: 1px solid var(--accent);
        padding-bottom: 4px;
      }

      .legacy {
        border-top: 1px solid var(--rule);
        padding: 80px 24px;
        max-width: 1280px;
        margin: 0 auto;
      }
      @media (min-width: 768px) { .legacy { padding: 120px 48px; } }
      .legacy-inner { max-width: 720px; }
      .legacy h2 {
        font-family: 'Italiana', serif;
        font-weight: 400;
        font-size: clamp(32px, 5vw, 60px);
        margin: 0 0 20px;
        line-height: 1.05;
      }
      .legacy h2 em {
        font-family: 'Cormorant Garamond', serif;
        font-style: italic;
        color: var(--fg-mid);
      }
      .legacy p {
        font-family: 'Cormorant Garamond', serif;
        font-size: 19px;
        color: var(--fg-mid);
        margin: 0 0 28px;
      }
      .legacy a {
        font-size: 12px;
        letter-spacing: 0.24em;
        text-transform: uppercase;
        color: var(--accent);
        border-bottom: 1px solid var(--accent);
        padding-bottom: 4px;
      }

      .foot {
        border-top: 1px solid var(--rule);
        padding: 28px 24px;
        text-align: center;
      }
      .foot p {
        font-size: 11px;
        letter-spacing: 0.28em;
        text-transform: uppercase;
        color: var(--fg-mid);
        margin: 0;
      }
    </style>
  </body>
</html>
