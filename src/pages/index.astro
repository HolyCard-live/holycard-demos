  {
    slug: 'aurora-editorial',
    title: 'Aurora Editorial',
    couple: 'Mateo & Valentina',
    location: 'Bariloche, Argentina',
    date: '11 · Septiembre · 2027',
    style: 'Editorial · Vogue',
    palette: ['#1a2332', '#c9a961', '#f5f1e8'],
    image: 'https://images.unsplash.com/photo-1583939003579-730e3918a45a?w=1200&auto=format&fit=crop&q=80',
    description: 'Composición editorial de revista. Tipografía dominante, fotografía a sangre, jerarquía asimétrica.',
  },
  {
    slug: 'costa-mediterranea',
    title: 'Costa Mediterránea',
    couple: 'Tomás & Isabella',
    location: 'Tulum, México',
    date: '06 · Junio · 2027',
    style: 'Boho · Beach',
    palette: ['#c8654a', '#e8d5b7', '#3d6b7c'],
    image: 'https://images.unsplash.com/photo-1530653333484-8d8b1ee0ed05?w=1200&auto=format&fit=crop&q=80',
    description: 'Atardeceres frente al mar. Acuarelas, formas orgánicas y arenas tibias.',
