    title: 'Maximalismo Floral',
    couple: 'Adrián & Camila',
    location: 'Hacienda Querétaro',
    date: '22 · Mayo · 2027',
    style: 'Garden · Romántico',
    palette: ['#722f37', '#d4a5a5', '#9eaa86'],
    image: 'https://images.unsplash.com/photo-1525772764200-be829a350797?w=1200&auto=format&fit=crop&q=80',
    description: 'Jardín en plena floración. Marcos ornamentales, ilustraciones densas, romanticismo barroco.',
  },
  {
    slug: 'art-deco-gatsby',
    title: 'Art Decó Gatsby',
    couple: 'Emiliano & Renata',
    location: 'Hotel · CDMX',
    date: '13 · Noviembre · 2027',
    style: 'Glamour · Black-tie',
    palette: ['#0a0a0a', '#d4af37', '#1f4e3d'],
    image: 'https://images.unsplash.com/photo-1519741497674-611481863552?w=1200&auto=format&fit=crop&q=80',
    description: 'Geometría dorada, simetría, dramatismo nocturno. Glamour de los años 20 en clave moderna.',
  },
  {
    slug: 'wabi-sabi',
    title: 'Wabi-Sabi',
    couple: 'Yuki & Sebastián',
    location: 'Jardín Kioto · CDMX',
    date: '04 · Abril · 2027',
    style: 'Minimal · Japonés',
    palette: ['#f4f1ec', '#1a1a1a', '#a0512c'],
    image: 'https://images.unsplash.com/photo-1522383225653-ed111181a951?w=1200&auto=format&fit=crop&q=80',
    description: 'Belleza imperfecta. Tinta sumi-e, espacio negativo y silencio tipográfico.',
  },
  {
    slug: 'neon-retro',
    title: 'Neon Retro',
    couple: 'Diego & Sofía',
    location: 'Las Vegas, NV',
    date: '08 · Agosto · 2027',
    style: 'Synthwave · Y2K',
    palette: ['#1b0a2e', '#ff2d95', '#00f5ff'],
    image: 'https://images.unsplash.com/photo-1605379399642-870262d3d051?w=1200&auto=format&fit=crop&q=80',
    description: 'Capilla neón, autopistas violetas, retro-futurismo. Los 80 nunca terminaron.',
  },
  {
    slug: 'rustico-mexicano',
    title: 'Rústico Mexicano',
    couple: 'Andrés & Mariana',
    location: 'San Miguel de Allende',
    date: '18 · Octubre · 2027',
    style: 'Hacienda · Folk',
    palette: ['#c4631e', '#8b1e1e', '#1a8a8a'],
    image: 'https://images.unsplash.com/photo-1518998053901-5348d3961a04?w=1200&auto=format&fit=crop&q=80',
