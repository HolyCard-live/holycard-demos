    /* DRESS */
    .ed-dress { max-width: 900px; margin: 0 auto; padding: 100px 24px; text-align: center; }
    .ed-dress-head h2 { font-size: clamp(32px, 4vw, 48px); margin: 0 0 32px; }
    .ed-dress-text { font-family: 'Cormorant Garamond', serif; font-size: 19px; line-height: 1.6; color: rgba(245,241,232,0.8); margin: 0 0 56px; }
    .ed-swatches { display: flex; justify-content: center; gap: 24px; flex-wrap: wrap; }
