    .ed-swatches span { display: block; width: 56px; height: 56px; border-radius: 50%; border: 1px solid rgba(201,169,97,0.3); }
    .ed-swatches p { margin: 12px 0 0; font-size: 11px; letter-spacing: 0.24em; text-transform: uppercase; }

    /* GIFTS */
    .ed-gifts { max-width: 1000px; margin: 0 auto; padding: 100px 24px; text-align: center; }
    .ed-gifts h2 { font-size: clamp(40px, 5vw, 64px); margin: 0 0 24px; }
    .ed-gifts-text { font-family: 'Cormorant Garamond', serif; font-size: 19px; color: rgba(245,241,232,0.8); margin: 0 0 56px; max-width: 640px; margin-left: auto; margin-right: auto; }
