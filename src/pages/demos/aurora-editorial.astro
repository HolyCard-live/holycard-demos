    .ed-loc-grid a { color: #c9a961; text-decoration: none; font-size: 12px; letter-spacing: 0.24em; text-transform: uppercase; border-bottom: 1px solid #c9a961; padding-bottom: 4px; }
    .ed-loc-hotel ul { list-style: none; padding: 0; margin: 16px 0 0; display: grid; gap: 12px; }
    .ed-loc-hotel li { font-family: 'Cormorant Garamond', serif; font-size: 17px; color: rgba(245,241,232,0.78); }
    .ed-loc-hotel li strong { color: #f5f1e8; }
