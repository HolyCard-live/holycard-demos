    .ed-end h2 { font-size: clamp(56px, 9vw, 120px); margin: 0 0 48px; }
    .ed-end-sig { font-family: 'Cormorant Garamond', serif; font-style: italic; font-size: 22px; color: rgba(245,241,232,0.7); margin: 0; }
  </style>

  <script>
    import gsap from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    gsap.registerPlugin(ScrollTrigger);

    // Splash
    const splash = document.getElementById('ed-splash');
    const cta = document.getElementById('ed-cta');
    if (splash) {
      document.body.style.overflow = 'hidden';
      const dismiss = () => {
        gsap.to('#ed-env', { y: -16, opacity: 0, duration: 0.5, ease: 'power2.in' });
        gsap.to(splash, { opacity: 0, duration: 0.6, delay: 0.3, ease: 'power2.in', onComplete: () => {
          splash.style.display = 'none';
          document.body.style.overflow = '';
        }});
      };
      cta?.addEventListener('click', dismiss);
      splash.addEventListener('click', (e) => { if (e.target === splash) dismiss(); });
    }

    // Animate
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (e.isIntersecting) {
          e.target.classList.add('in');
          io.unobserve(e.target);
        }
      }
    }, { threshold: 0.12 });
    document.querySelectorAll('[data-animate]').forEach(el => io.observe(el));

    // Hero parallax
    const heroImg = document.querySelector<HTMLImageElement>('.ed-hero img');
    if (heroImg && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      gsap.to(heroImg, {
        yPercent: 12, ease: 'none',
        scrollTrigger: { trigger: '.ed-hero', start: 'top top', end: 'bottom top', scrub: true },
      });
    }

    // Countdown
    const target = new Date('2027-09-11T16:30:00-03:00').getTime();
    const tick = () => {
      const diff = target - Date.now();
      if (diff <= 0) return;
      const d = Math.floor(diff / 86400000);
      const h = Math.floor((diff / 3600000) % 24);
      const m = Math.floor((diff / 60000) % 60);
      const s = Math.floor((diff / 1000) % 60);
      const set = (id: string, v: number) => { const el = document.getElementById(id); if (el) el.textContent = String(v).padStart(2, '0'); };
      set('ed-d', d); set('ed-h', h); set('ed-m', m); set('ed-s', s);
    };
    tick(); setInterval(tick, 1000);

    // RSVP fake
    const form = document.getElementById('ed-rsvp-form');
    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      document.getElementById('ed-rsvp-ok')?.removeAttribute('hidden');
      (form as HTMLFormElement).reset();
    });
  </script>
</DemoLayout>
