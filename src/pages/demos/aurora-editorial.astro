    /* RSVP */
    .ed-rsvp { max-width: 720px; margin: 0 auto; padding: 100px 24px; text-align: center; }
    .ed-rsvp h2 { font-size: clamp(36px, 5vw, 56px); margin: 0 0 48px; }
