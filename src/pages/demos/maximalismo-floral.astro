    .fl-swatches { display: flex; justify-content: center; gap: 18px; flex-wrap: wrap; }
    .fl-swatches > div { text-align: center; }
    .fl-swatches span { display: block; width: 56px; height: 56px; border-radius: 50%; border: 1px solid rgba(114,47,55,0.2); }
