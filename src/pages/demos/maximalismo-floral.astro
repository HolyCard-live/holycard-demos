    #fl-rsvp-form { display: grid; gap: 18px; text-align: left; }
    #fl-rsvp-form label { display: grid; gap: 6px; }
    #fl-rsvp-form span { font-size: 11px; letter-spacing: 0.28em; text-transform: uppercase; color: #722f37; }
    #fl-rsvp-form input, #fl-rsvp-form select { background: #fff; border: 1px solid rgba(114,47,55,0.25); padding: 12px 14px; font-size: 16px; font-family: 'Cormorant Garamond', serif; color: #3a2d2d; outline: none; transition: border-color 0.2s ease; }
