---
import DemoLayout from '../../layouts/DemoLayout.astro';
const fonts = 'https://fonts.googleapis.com/css2?family=Italiana&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=Tenor+Sans&display=swap';
---
<DemoLayout
  title="Adrián & Camila · 22·05·2027 · Hacienda Querétaro"
  description="Una boda en plena floración, Hacienda Galindo, Querétaro."
  themeColor="#f7f1e8"
  bodyClass="floral-body"
  fontsHref={fonts}
  ogImage="https://images.unsplash.com/photo-1525772764200-be829a350797?w=1200&auto=format&fit=crop&q=80"
  progressColor="#722f37"
>

  <!-- ============ SVG SYMBOLS (florales) ============ -->
  <svg width="0" height="0" style="position:absolute" aria-hidden="true">
    <defs>
      <symbol id="fl-rose" viewBox="0 0 100 100">
        <g fill="#d4a5a5" stroke="#722f37" stroke-width="0.5">
          <circle cx="50" cy="50" r="6" fill="#722f37"/>
          <path d="M50,40 Q42,38 38,46 Q40,52 48,52 Q50,46 50,40 Z"/>
          <path d="M50,40 Q58,38 62,46 Q60,52 52,52 Q50,46 50,40 Z"/>
          <path d="M44,50 Q34,52 32,62 Q42,68 50,60 Q48,54 44,50 Z"/>
          <path d="M56,50 Q66,52 68,62 Q58,68 50,60 Q52,54 56,50 Z"/>
          <path d="M50,56 Q40,62 42,72 Q50,76 58,72 Q60,62 50,56 Z"/>
        </g>
        <g stroke="#9eaa86" stroke-width="1" fill="#9eaa86" opacity="0.85">
          <ellipse cx="20" cy="55" rx="14" ry="6" transform="rotate(-25 20 55)"/>
          <ellipse cx="80" cy="55" rx="14" ry="6" transform="rotate(25 80 55)"/>
          <ellipse cx="50" cy="20" rx="6" ry="14"/>
        </g>
      </symbol>
      <symbol id="fl-sprig" viewBox="0 0 80 120">
        <path d="M40,5 Q42,40 40,80 Q38,100 40,115" stroke="#722f37" stroke-width="0.8" fill="none"/>
        <ellipse cx="22" cy="30" rx="14" ry="5" transform="rotate(-30 22 30)" fill="#9eaa86"/>
        <ellipse cx="58" cy="40" rx="14" ry="5" transform="rotate(30 58 40)" fill="#9eaa86"/>
        <ellipse cx="22" cy="60" rx="14" ry="5" transform="rotate(-30 22 60)" fill="#9eaa86"/>
        <ellipse cx="58" cy="70" rx="14" ry="5" transform="rotate(30 58 70)" fill="#9eaa86"/>
        <ellipse cx="22" cy="90" rx="12" ry="4" transform="rotate(-30 22 90)" fill="#9eaa86"/>
        <ellipse cx="58" cy="100" rx="12" ry="4" transform="rotate(30 58 100)" fill="#9eaa86"/>
      </symbol>
      <symbol id="fl-corner" viewBox="0 0 200 200">
        <g stroke="#722f37" stroke-width="0.6" fill="none">
          <path d="M0,200 Q60,180 100,140 Q140,100 200,80"/>
          <path d="M30,200 Q70,170 110,130"/>
        </g>
        <use href="#fl-rose" x="20" y="120" width="50" height="50" />
        <use href="#fl-rose" x="100" y="60" width="40" height="40" />
        <use href="#fl-sprig" x="60" y="80" width="50" height="80" />
        <use href="#fl-sprig" x="130" y="20" width="40" height="60" />
      </symbol>
    </defs>
  </svg>

  <!-- ============ SPLASH ============ -->
  <div id="fl-splash" class="fl-splash">
    <svg class="fl-splash-corner fl-tl" viewBox="0 0 200 200"><use href="#fl-corner"/></svg>
    <svg class="fl-splash-corner fl-tr" viewBox="0 0 200 200"><use href="#fl-corner"/></svg>
    <svg class="fl-splash-corner fl-bl" viewBox="0 0 200 200"><use href="#fl-corner"/></svg>
    <svg class="fl-splash-corner fl-br" viewBox="0 0 200 200"><use href="#fl-corner"/></svg>
    <div class="fl-splash-inner">
      <p class="fl-pre">Acompáñanos a celebrar el amor</p>
      <h1>Adrián <span>&amp;</span> Camila</h1>
      <div class="fl-divider"><span></span><svg viewBox="0 0 30 30"><circle cx="15" cy="15" r="3" fill="#722f37"/></svg><span></span></div>
      <p class="fl-date">XXII · Mayo · MMXXVII</p>
      <button id="fl-cta">Recibe la invitación</button>
    </div>
  </div>

  <!-- ============ HERO ============ -->
  <section class="fl-hero">
    <img src="https://images.unsplash.com/photo-1525772764200-be829a350797?w=1800&auto=format&fit=crop&q=85" alt="Adrián y Camila"/>
    <div class="fl-hero-overlay"></div>
    <svg class="fl-hero-corner fl-hc-tl" viewBox="0 0 200 200"><use href="#fl-corner"/></svg>
    <svg class="fl-hero-corner fl-hc-tr" viewBox="0 0 200 200"><use href="#fl-corner"/></svg>
    <svg class="fl-hero-corner fl-hc-bl" viewBox="0 0 200 200"><use href="#fl-corner"/></svg>
    <svg class="fl-hero-corner fl-hc-br" viewBox="0 0 200 200"><use href="#fl-corner"/></svg>
    <div class="fl-hero-text">
      <p class="fl-hero-pre">Sus padres, junto con la pareja, le invitan a la boda de</p>
      <h1>Adrián <em>&amp;</em> Camila</h1>
      <p class="fl-hero-date">22 · Mayo · 2027 · 16:00 hrs</p>
      <p class="fl-hero-loc">Hacienda Galindo · San Juan del Río · Querétaro</p>
    </div>
  </section>

  <!-- ============ PADRES ============ -->
  <section class="fl-parents" data-animate>
    <div class="fl-parents-row">
      <div>
        <p class="fl-kicker">Padres del novio</p>
        <p class="fl-parents-name">Roberto Alcalá Mendoza</p>
        <p class="fl-parents-name">Patricia Salinas de Alcalá</p>
      </div>
      <div class="fl-parents-flower"><svg viewBox="0 0 100 100"><use href="#fl-rose"/></svg></div>
      <div>
        <p class="fl-kicker">Padres de la novia</p>
        <p class="fl-parents-name">Mauricio Bustos Reyes <em>†</em></p>
        <p class="fl-parents-name">Ofelia Vázquez Lara</p>
      </div>
    </div>
    <div class="fl-padrinos">
      <p class="fl-kicker center">Padrinos de honor</p>
      <p>Eduardo Bustos · María Fernanda Salinas</p>
    </div>
  </section>

  <!-- ============ FRASE ============ -->
  <section class="fl-quote" data-animate>
    <svg class="fl-quote-flower" viewBox="0 0 100 100"><use href="#fl-rose"/></svg>
    <blockquote>
      "Te amaré siempre. Mientras los días tengan número, mientras los nombres tengan letras,
      mientras la primavera regrese a su jardín."
    </blockquote>
    <p>— Manuscrito encontrado en una libreta antigua</p>
  </section>

  <!-- ============ MENSAJE ============ -->
  <section class="fl-letter">
    <div class="fl-letter-frame" data-animate>
      <p class="fl-script">Querida familia, queridos amigos:</p>
      <p>
        Después de ocho años, miles de cafés, dos perros y una casa que armamos pieza por pieza,
        decidimos casarnos donde mejor florece todo: en una hacienda con jardines vivos.
      </p>
      <p>
        Queremos un día con olor a tierra mojada y a azahar, con mesas largas y conversaciones
        más largas todavía. Sin prisa. Con todo el tiempo del mundo para mirarnos.
      </p>
      <p>
        Nada de esto tiene sentido si no estás. Reserva el día. Trae a quien te quiera bien.
      </p>
      <p class="fl-sign">Con todo nuestro amor,<br/><span>Adrián &amp; Camila</span></p>
    </div>
  </section>

  <!-- ============ COUNTDOWN ============ -->
  <section class="fl-cd" data-animate>
    <p class="fl-kicker center">El reloj del jardín</p>
    <div class="fl-cd-ornament" aria-hidden="true">
      <svg viewBox="0 0 200 30"><path d="M0,15 Q50,5 100,15 Q150,25 200,15" stroke="#722f37" stroke-width="0.6" fill="none"/><circle cx="100" cy="15" r="3" fill="#722f37"/></svg>
    </div>
    <div class="fl-cd-grid">
      <div><span id="fl-d">--</span><p>Días</p></div>
      <div><span id="fl-h">--</span><p>Horas</p></div>
      <div><span id="fl-m">--</span><p>Minutos</p></div>
      <div><span id="fl-s">--</span><p>Segundos</p></div>
    </div>
  </section>

  <!-- ============ HISTORIA ============ -->
  <section class="fl-story">
    <div class="fl-story-head" data-animate>
      <p class="fl-kicker center">Nuestra historia</p>
      <h2>Cómo florecimos<br/><em>juntos.</em></h2>
    </div>
    <div class="fl-story-grid">
      <article data-animate>
        <svg viewBox="0 0 100 100" class="fl-story-icon"><use href="#fl-rose"/></svg>
        <p class="fl-year">2018</p>
        <h3>Boda de un amigo en común.</h3>
        <p>Bailamos seis canciones. Él se acordó del color del vestido. Ella, del nombre del cocktail.</p>
      </article>
      <article data-animate>
        <svg viewBox="0 0 100 100" class="fl-story-icon"><use href="#fl-rose"/></svg>
        <p class="fl-year">2020</p>
        <h3>El primer "te quiero".</h3>
        <p>Lo dijo él, en un Uber, después de una fiesta de disfraces. Ella se rió. Después lo dijo también.</p>
      </article>
      <article data-animate>
        <svg viewBox="0 0 100 100" class="fl-story-icon"><use href="#fl-rose"/></svg>
        <p class="fl-year">2022</p>
        <h3>Compramos casa.</h3>
        <p>Una con patio. Plantamos un limonero. Sigue ahí, dando.</p>
      </article>
      <article data-animate>
        <svg viewBox="0 0 100 100" class="fl-story-icon"><use href="#fl-rose"/></svg>
        <p class="fl-year">2024</p>
        <h3>La pedida.</h3>
        <p>En la cocina, junto al limonero. Anillo de la abuela materna. Llanto de los dos.</p>
      </article>
      <article data-animate>
        <svg viewBox="0 0 100 100" class="fl-story-icon"><use href="#fl-rose"/></svg>
        <p class="fl-year">2027</p>
        <h3>Hacienda Galindo.</h3>
        <p>Volvemos a una boda. Esta vez de los dos.</p>
      </article>
    </div>
  </section>

  <!-- ============ GALERÍA ============ -->
  <section class="fl-gallery" data-animate>
    <div class="fl-gal-head">
      <svg viewBox="0 0 80 120" class="fl-sprig-deco"><use href="#fl-sprig"/></svg>
      <p class="fl-kicker">Recuerdos</p>
      <h2>Álbum del jardín.</h2>
    </div>
    <div class="fl-gal-grid">
      <figure><img src="https://images.unsplash.com/photo-1465495976277-4387d4b0b4c6?w=900&auto=format&fit=crop&q=80" alt=""/></figure>
      <figure class="fl-gal-tall"><img src="https://images.unsplash.com/photo-1606800052052-a08af7148866?w=900&auto=format&fit=crop&q=80" alt=""/></figure>
      <figure><img src="https://images.unsplash.com/photo-1485463611174-f302f6a5c1c9?w=900&auto=format&fit=crop&q=80" alt=""/></figure>
      <figure><img src="https://images.unsplash.com/photo-1519741497674-611481863552?w=900&auto=format&fit=crop&q=80" alt=""/></figure>
      <figure><img src="https://images.unsplash.com/photo-1595407279248-d83bcf1bdd3e?w=900&auto=format&fit=crop&q=80" alt=""/></figure>
      <figure class="fl-gal-tall"><img src="https://images.unsplash.com/photo-1525772764200-be829a350797?w=900&auto=format&fit=crop&q=80" alt=""/></figure>
    </div>
  </section>

  <!-- ============ ITINERARIO ============ -->
  <section class="fl-program">
    <div class="fl-program-head" data-animate>
      <p class="fl-kicker center">Programa del día</p>
      <h2>El orden de las flores.</h2>
    </div>
    <div class="fl-program-list">
      <div class="fl-pr-item" data-animate>
        <div class="fl-pr-time">16:00</div>
        <div class="fl-pr-body"><h4>Ceremonia religiosa</h4><p>Capilla de la Hacienda. Misa de bodas con coro.</p></div>
      </div>
      <div class="fl-pr-item" data-animate>
        <div class="fl-pr-time">17:30</div>
        <div class="fl-pr-body"><h4>Coctel en los jardines</h4><p>Mariachi en vivo, mezcalitas, frituras.</p></div>
      </div>
      <div class="fl-pr-item" data-animate>
        <div class="fl-pr-time">19:30</div>
        <div class="fl-pr-body"><h4>Cena de gala</h4><p>Banquete bajo la pérgola con luces cálidas.</p></div>
      </div>
      <div class="fl-pr-item" data-animate>
        <div class="fl-pr-time">21:30</div>
        <div class="fl-pr-body"><h4>Vals y primer baile</h4><p>Vals con bisabuelas si el cardiologo lo permite.</p></div>
      </div>
      <div class="fl-pr-item" data-animate>
        <div class="fl-pr-time">22:30</div>
        <div class="fl-pr-body"><h4>Pista &amp; sorpresa</h4><p>Sí, es la sorpresa. No diremos más.</p></div>
      </div>
      <div class="fl-pr-item" data-animate>
        <div class="fl-pr-time">02:30</div>
        <div class="fl-pr-body"><h4>Tornaboda</h4><p>Chilaquiles y café de olla para los que vivan al día siguiente.</p></div>
      </div>
    </div>
  </section>

  <!-- ============ UBICACIÓN ============ -->
  <section class="fl-loc" data-animate>
    <p class="fl-kicker center">Hacienda</p>
    <h2>Hacienda Galindo</h2>
    <p class="fl-loc-text">
      Hacienda virreinal del siglo XVII, fundada por Hernán Cortés y heredada a la Malinche. Hoy
      hotel boutique con jardines de más de 12 hectáreas, capilla, pérgolas y cuartos hospitalarios.
    </p>
    <div class="fl-loc-img">
      <img src="https://images.unsplash.com/photo-1568605114967-8130f3a36994?w=1200&auto=format&fit=crop&q=80" alt="Hacienda Galindo"/>
    </div>
    <p class="fl-loc-address"><strong>Carretera Amealco-Galindo Km 5.</strong> · San Juan del Río, Querétaro · 76814</p>
    <a class="fl-loc-cta" href="https://maps.google.com" target="_blank" rel="noopener">Ver en mapa →</a>
    <div class="fl-trans">
      <h4>Cómo llegar</h4>
      <ul>
        <li><strong>En auto:</strong> Carretera 57, salida San Juan del Río. 2h 15min desde CDMX.</li>
        <li><strong>Avión:</strong> Aeropuerto QRO (35 min en taxi).</li>
        <li><strong>Camión organizado:</strong> Salida desde CDMX (Polanco) a las 11:00 hrs · regreso 03:00 hrs · cupo limitado, especifica al confirmar.</li>
      </ul>
    </div>
  </section>

  <!-- ============ DRESS CODE ============ -->
  <section class="fl-dress" data-animate>
    <p class="fl-kicker center">Código de vestimenta</p>
    <h2>Formal de jardín</h2>
    <p class="fl-dress-text">
      Ellas: vestido largo o midi, suela cómoda (los jardines son pasto). Ellos: traje claro u oscuro,
      preferimos sin corbata. Tonos sugeridos abajo. <em>Por favor, evita el blanco</em> — que ese día solo florezca uno.
    </p>
    <div class="fl-swatches">
      <div><span style="background:#722f37"></span><p>Borgoña</p></div>
      <div><span style="background:#d4a5a5"></span><p>Rosa polvo</p></div>
      <div><span style="background:#9eaa86"></span><p>Salvia</p></div>
      <div><span style="background:#c8b89a"></span><p>Champagne</p></div>
      <div><span style="background:#3d4a3a"></span><p>Bosque</p></div>
      <div><span style="background:#6b4a3a"></span><p>Cacao</p></div>
    </div>
  </section>

  <!-- ============ NIÑOS ============ -->
  <section class="fl-kids" data-animate>
    <svg viewBox="0 0 100 100" class="fl-kids-icon"><use href="#fl-rose"/></svg>
    <h2>Adultos · 18+</h2>
    <p>
      Amamos a tus pequeños. Por la naturaleza del lugar y la duración del evento, hemos decidido
      que sea solo para adultos. Si necesitas recomendación de niñera de confianza en la hacienda,
      avísanos al confirmar.
    </p>
  </section>

  <!-- ============ REGALOS ============ -->
  <section class="fl-gifts" data-animate>
    <p class="fl-kicker center">Mesa de regalos</p>
    <h2>Tu presencia <em>es nuestro mejor regalo.</em></h2>
    <div class="fl-gifts-grid">
      <div class="fl-gift">
        <h4>Sobre el evento</h4>
        <p>En la entrada habrá un cofre con sobres bordados. Acepta el placer del gesto antiguo.</p>
      </div>
      <div class="fl-gift">
        <h4>Transferencia</h4>
        <p>Banamex · 5256 7891 4523 7800<br/>CLABE: 002180056789012345<br/>Adrián Alcalá / Camila Bustos</p>
      </div>
      <div class="fl-gift">
        <h4>Mesa Liverpool</h4>
        <p>Evento <em>59342</em> · Búscanos por "Alcalá-Bustos".</p>
      </div>
      <div class="fl-gift">
        <h4>Luna de miel</h4>
        <p>Vamos a Toscana. Cada aporte es una copa de chianti, una pasta, un atardecer en colina.</p>
      </div>
    </div>
  </section>

  <!-- ============ RSVP ============ -->
  <section class="fl-rsvp" data-animate>
    <p class="fl-kicker center">Confirmación</p>
    <h2>Sé parte<br/>del jardín.</h2>
    <p class="fl-deadline">Confirmaciones antes del 30 de abril de 2027.</p>
    <form id="fl-rsvp-form" novalidate>
      <label><span>Nombre completo</span><input type="text" name="name" required/></label>
      <div class="fl-row">
        <label><span>Asistencia</span><select name="attend"><option>Confirmo asistencia</option><option>No podré asistir</option></select></label>
        <label><span>Pase para</span><select name="guests"><option>1 persona</option><option>2 personas</option></select></label>
      </div>
      <label><span>Restricciones alimentarias</span><input type="text" name="diet" placeholder="Vegetariano, sin gluten, alergias..."/></label>
      <label><span>¿Necesitas autobús desde CDMX?</span><select name="bus"><option>No, voy por mi cuenta</option><option>Sí, ida y vuelta</option><option>Solo ida</option><option>Solo regreso</option></select></label>
      <label><span>Una canción que <em>tienen</em> que tocar</span><input type="text" name="song"/></label>
      <button type="submit">Confirmar</button>
      <p id="fl-rsvp-ok" class="fl-rsvp-ok" hidden>Recibido. Cada flor florecerá un poco más sabiendo que vienes.</p>
    </form>
  </section>

  <!-- ============ PLAYLIST ============ -->
  <section class="fl-pl" data-animate>
    <p class="fl-kicker center">La selección musical</p>
    <h2>Lo que va a sonar.</h2>
    <ol class="fl-pl-list">
      <li><span>I.</span><strong>Promise</strong><em>Ben Howard</em></li>
      <li><span>II.</span><strong>Te Esperaré</strong><em>Carla Morrison</em></li>
      <li><span>III.</span><strong>Mil Años</strong><em>Christina Perri</em></li>
      <li><span>IV.</span><strong>Es Por Ti</strong><em>Juanes</em></li>
      <li><span>V.</span><strong>L-O-V-E</strong><em>Nat King Cole</em></li>
      <li><span>VI.</span><strong>Como Yo Te Amo</strong><em>Rocío Jurado</em></li>
      <li><span>VII.</span><strong>Stand By Me</strong><em>Ben E. King</em></li>
    </ol>
  </section>

  <!-- ============ HASHTAG ============ -->
  <section class="fl-hash" data-animate>
    <p class="fl-kicker center">Comparte el día con nosotros</p>
    <h2 class="fl-hash-tag">#AdriánYCamila2027</h2>
    <p>Comparte tus fotos. Estarás contribuyendo al álbum más grande, vivo y desordenado de nuestra vida.</p>
  </section>

  <!-- ============ CIERRE ============ -->
  <section class="fl-end">
    <svg class="fl-end-corner fl-ec-tl" viewBox="0 0 200 200"><use href="#fl-corner"/></svg>
    <svg class="fl-end-corner fl-ec-tr" viewBox="0 0 200 200"><use href="#fl-corner"/></svg>
    <svg class="fl-end-corner fl-ec-bl" viewBox="0 0 200 200"><use href="#fl-corner"/></svg>
    <svg class="fl-end-corner fl-ec-br" viewBox="0 0 200 200"><use href="#fl-corner"/></svg>
    <div class="fl-end-inner" data-animate>
      <p class="fl-script">Y, sobre todo,</p>
      <h2>Gracias por ser parte<br/><em>de nuestro jardín.</em></h2>
      <p class="fl-end-sig">Adrián &amp; Camila · Mayo 2027</p>
    </div>
  </section>

  <style is:global>
    .floral-body {
      background: #f7f1e8;
      color: #3a2d2d;
      font-family: 'Tenor Sans', sans-serif;
      font-weight: 400;
      letter-spacing: 0.02em;
    }
    .floral-body h1, .floral-body h2, .floral-body h3, .floral-body h4 {
      font-family: 'Italiana', serif;
      font-weight: 400;
      color: #3a2d2d;
    }
    .floral-body em { font-family: 'Cormorant Garamond', serif; font-style: italic; font-weight: 300; }
    .floral-body [data-animate] { opacity: 0; transform: translateY(28px); transition: opacity 1.2s ease, transform 1.2s ease; }
    .floral-body [data-animate].in { opacity: 1; transform: none; }
    .floral-body .fl-kicker {
      font-family: 'Tenor Sans', sans-serif;
      font-size: 11px;
      letter-spacing: 0.36em;
      text-transform: uppercase;
      color: #722f37;
      margin: 0 0 16px;
    }
    .floral-body .fl-kicker.center { text-align: center; }
    .floral-body .fl-script {
      font-family: 'Cormorant Garamond', serif;
      font-style: italic;
      font-size: 28px;
      color: #722f37;
    }

    /* SPLASH */
    .fl-splash {
      position: fixed; inset: 0; z-index: 100;
      background: #f7f1e8;
      display: flex; align-items: center; justify-content: center;
      padding: 32px;
      transition: opacity 0.7s ease;
    }
    .fl-splash-corner { position: absolute; width: clamp(120px, 22vw, 220px); height: clamp(120px, 22vw, 220px); opacity: 0.85; }
    .fl-tl { top: 0; left: 0; }
    .fl-tr { top: 0; right: 0; transform: scaleX(-1); }
    .fl-bl { bottom: 0; left: 0; transform: scaleY(-1); }
    .fl-br { bottom: 0; right: 0; transform: scale(-1, -1); }
    .fl-splash-inner {
      text-align: center;
      padding: 50px 32px;
      max-width: 420px;
    }
    .fl-pre { font-size: 11px; letter-spacing: 0.32em; text-transform: uppercase; color: #722f37; margin: 0 0 28px; }
    .fl-splash-inner h1 {
