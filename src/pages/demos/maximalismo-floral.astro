    .fl-hash-tag { font-family: 'Cormorant Garamond', serif !important; font-style: italic; font-size: clamp(28px, 5vw, 56px); color: #722f37 !important; margin: 16px 0 24px; word-break: break-word; }
    .fl-hash p { font-family: 'Cormorant Garamond', serif; font-size: 18px; color: #4a3a3a; margin: 0; }

    /* END */
    .fl-end { position: relative; padding: 120px 32px; text-align: center; background: #ede2d4; }
