    /* KIDS */
    .fl-kids { padding: 60px 24px; max-width: 720px; margin: 0 auto; text-align: center; border-top: 1px solid rgba(114,47,55,0.15); border-bottom: 1px solid rgba(114,47,55,0.15); }
    .fl-kids-icon { width: 60px; height: 60px; margin: 0 auto 16px; display: block; opacity: 0.85; }
    .fl-kids h2 { font-size: clamp(28px, 4vw, 40px); margin: 0 0 16px; }
