    .mx-swatches span { display: block; width: 56px; height: 56px; border-radius: 50%; border: 2px solid #fff; box-shadow: 0 2px 8px rgba(0,0,0,0.15); }
    .mx-swatches p { margin: 12px 0 0; font-family: 'Lobster', cursive; font-size: 14px; color: #3a2818; }

    /* KIDS */
