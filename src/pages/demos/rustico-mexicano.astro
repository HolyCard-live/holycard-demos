---
import DemoLayout from '../../layouts/DemoLayout.astro';
const fonts = 'https://fonts.googleapis.com/css2?family=Abril+Fatface&family=Lobster&family=Cormorant+Garamond:ital,wght@0,400;1,400&family=Inter:wght@300;400;500&display=swap';
---
<DemoLayout
  title="Andrés & Mariana · 18·10·2027 · San Miguel de Allende"
  description="Boda mexicana en Hacienda Las Trancas, San Miguel de Allende."
  themeColor="#f5e8d0"
  bodyClass="mex-body"
  fontsHref={fonts}
  ogImage="https://images.unsplash.com/photo-1518998053901-5348d3961a04?w=1200&auto=format&fit=crop&q=80"
  progressColor="#8b1e1e"
>

  <svg width="0" height="0" style="position:absolute" aria-hidden="true">
    <defs>
      <pattern id="mx-papel" width="120" height="100" patternUnits="userSpaceOnUse">
        <rect width="120" height="100" fill="none"/>
        <g fill="#8b1e1e">
          <circle cx="20" cy="20" r="6"/>
          <circle cx="60" cy="20" r="6"/>
          <circle cx="100" cy="20" r="6"/>
          <path d="M40,40 L60,50 L40,60 L20,50 Z"/>
          <path d="M80,40 L100,50 L80,60 L60,50 Z"/>
          <path d="M0,40 L20,50 L0,60 L-20,50 Z"/>
          <circle cx="30" cy="80" r="4"/>
          <circle cx="60" cy="85" r="4"/>
          <circle cx="90" cy="80" r="4"/>
          <path d="M0,0 L20,10 L0,20 Z" opacity="0.6"/>
          <path d="M120,0 L100,10 L120,20 Z" opacity="0.6"/>
        </g>
      </pattern>

      <symbol id="mx-marigold" viewBox="0 0 100 100">
        <g>
          <circle cx="50" cy="50" r="8" fill="#8b3a0e"/>
          <g fill="#f4a14e">
            <ellipse cx="50" cy="20" rx="8" ry="14"/>
            <ellipse cx="50" cy="80" rx="8" ry="14"/>
            <ellipse cx="20" cy="50" rx="14" ry="8"/>
            <ellipse cx="80" cy="50" rx="14" ry="8"/>
            <ellipse cx="28" cy="28" rx="10" ry="12" transform="rotate(45 28 28)"/>
            <ellipse cx="72" cy="28" rx="10" ry="12" transform="rotate(-45 72 28)"/>
            <ellipse cx="28" cy="72" rx="10" ry="12" transform="rotate(-45 28 72)"/>
            <ellipse cx="72" cy="72" rx="10" ry="12" transform="rotate(45 72 72)"/>
          </g>
          <g fill="#c4631e">
            <ellipse cx="50" cy="32" rx="6" ry="10"/>
            <ellipse cx="50" cy="68" rx="6" ry="10"/>
            <ellipse cx="32" cy="50" rx="10" ry="6"/>
            <ellipse cx="68" cy="50" rx="10" ry="6"/>
            <ellipse cx="36" cy="36" rx="6" ry="8" transform="rotate(45 36 36)"/>
            <ellipse cx="64" cy="36" rx="6" ry="8" transform="rotate(-45 64 36)"/>
            <ellipse cx="36" cy="64" rx="6" ry="8" transform="rotate(-45 36 64)"/>
            <ellipse cx="64" cy="64" rx="6" ry="8" transform="rotate(45 64 64)"/>
          </g>
        </g>
      </symbol>

      <symbol id="mx-talavera" viewBox="0 0 100 100">
        <rect width="100" height="100" fill="#1a8a8a"/>
        <g fill="#f5e8d0" opacity="0.85">
          <circle cx="50" cy="50" r="14"/>
          <path d="M50,10 L55,40 L50,50 L45,40 Z"/>
          <path d="M50,90 L55,60 L50,50 L45,60 Z"/>
          <path d="M10,50 L40,55 L50,50 L40,45 Z"/>
          <path d="M90,50 L60,55 L50,50 L60,45 Z"/>
          <path d="M22,22 L38,42 L22,38 Z"/>
          <path d="M78,22 L62,42 L78,38 Z"/>
          <path d="M22,78 L38,58 L22,62 Z"/>
          <path d="M78,78 L62,58 L78,62 Z"/>
        </g>
        <circle cx="50" cy="50" r="6" fill="#8b1e1e"/>
        <g fill="#c4631e">
          <circle cx="50" cy="20" r="3"/>
          <circle cx="50" cy="80" r="3"/>
          <circle cx="20" cy="50" r="3"/>
          <circle cx="80" cy="50" r="3"/>
        </g>
      </symbol>

      <pattern id="mx-talavera-pattern" width="40" height="40" patternUnits="userSpaceOnUse">
        <use href="#mx-talavera" width="40" height="40"/>
      </pattern>

      <symbol id="mx-banner" viewBox="0 0 1200 100" preserveAspectRatio="none">
        <rect x="0" y="0" width="1200" height="80" fill="url(#mx-papel)"/>
        <path d="M0,80 L60,80 L80,100 L100,80 L160,80 L180,100 L200,80 L260,80 L280,100 L300,80 L360,80 L380,100 L400,80 L460,80 L480,100 L500,80 L560,80 L580,100 L600,80 L660,80 L680,100 L700,80 L760,80 L780,100 L800,80 L860,80 L880,100 L900,80 L960,80 L980,100 L1000,80 L1060,80 L1080,100 L1100,80 L1160,80 L1180,100 L1200,80 Z" fill="#8b1e1e"/>
      </symbol>
    </defs>
  </svg>

  <!-- ============ SPLASH ============ -->
  <div id="mx-splash" class="mx-splash">
    <svg class="mx-papel-top" viewBox="0 0 1200 100" preserveAspectRatio="none"><use href="#mx-banner"/></svg>
    <div class="mx-splash-content">
      <svg class="mx-marigold-deco" viewBox="0 0 100 100"><use href="#mx-marigold"/></svg>
      <p class="mx-pre">Vivan los novios</p>
      <h1>Andrés <span>y</span> Mariana</h1>
      <p class="mx-issue">18 · Octubre · 2027</p>
      <p class="mx-issue-loc">San Miguel de Allende</p>
      <button id="mx-cta">Ábreme la puerta</button>
    </div>
    <svg class="mx-papel-bot" viewBox="0 0 1200 100" preserveAspectRatio="none"><use href="#mx-banner"/></svg>
  </div>

  <!-- ============ HERO ============ -->
  <section class="mx-hero">
    <img src="https://images.unsplash.com/photo-1518998053901-5348d3961a04?w=1800&auto=format&fit=crop&q=85" alt="San Miguel de Allende"/>
    <div class="mx-hero-overlay"></div>
    <svg class="mx-papel-hero-top" viewBox="0 0 1200 100" preserveAspectRatio="none"><use href="#mx-banner"/></svg>
    <div class="mx-hero-text">
      <p class="mx-hero-pre">Acompáñanos a celebrar nuestro</p>
      <h1>SÍ <em>acepto</em></h1>
      <p class="mx-hero-couple">Andrés &amp; Mariana</p>
      <div class="mx-hero-meta">
        <p>18 · Octubre · 2027</p>
        <p>San Miguel de Allende, Gto.</p>
      </div>
    </div>
  </section>

  <!-- ============ PADRES ============ -->
  <section class="mx-parents" data-animate>
    <div class="mx-parents-decor">
      <svg viewBox="0 0 100 100"><use href="#mx-marigold"/></svg>
    </div>
    <p class="mx-pre center">Con la bendición de Dios y de nuestros padres</p>
    <div class="mx-parents-grid">
      <div>
        <p class="mx-parents-title">Padres del novio</p>
        <p class="mx-parents-name">Sr. Joaquín Vargas Solís</p>
        <p class="mx-parents-name">Sra. Eugenia Hernández de Vargas</p>
      </div>
      <div>
        <p class="mx-parents-title">Padres de la novia</p>
        <p class="mx-parents-name">Sr. Ignacio Ramírez Olvera</p>
        <p class="mx-parents-name">Sra. Lucía Castillo de Ramírez</p>
      </div>
    </div>
    <div class="mx-padrinos">
      <p class="mx-pre center">Padrinos de velación</p>
      <p>Tío Eduardo Hernández · Tía Rosario Olvera</p>
      <p class="mx-pre center mt">Padrinos de lazo</p>
      <p>Don José Luis Vargas · Doña Esperanza Camargo</p>
    </div>
  </section>

  <!-- ============ FRASE ============ -->
  <section class="mx-quote" data-animate>
    <svg class="mx-quote-flower" viewBox="0 0 100 100"><use href="#mx-marigold"/></svg>
    <blockquote>
      "El amor, cuando es de verdad, llega como llega el cempasúchil:<br/>
      con flor amarilla y de golpe."
    </blockquote>
    <p>— Dicho de Doña Eugenia, abuela del novio.</p>
  </section>

  <!-- ============ MENSAJE ============ -->
  <section class="mx-letter">
    <div class="mx-letter-frame" data-animate>
      <p class="mx-script">¡Qué gusto que estés aquí!</p>
      <p>
        Llevamos cinco años saliendo y dos viviendo juntos en una casita en la Roma. Crecimos
        en el norte, en el centro, y nos encontramos en CDMX. Pero el corazón nos jaló para
        el bajío: queremos casarnos en San Miguel, donde el cantera, la marigold y la cumbia
        nos han dado los mejores fines de semana de nuestras vidas.
      </p>
      <p>
        Habrá mariachi. Habrá mole. Habrá tequila. Habrá muchas tías y muchos primos.
        Habrá lo mejor de México.
      </p>
      <p class="mx-sign">Con cariño,<br/><span>Andrés y Mariana</span></p>
    </div>
  </section>

  <!-- ============ COUNTDOWN ============ -->
  <section class="mx-cd" data-animate>
    <p class="mx-pre center">Faltan</p>
    <div class="mx-cd-grid">
      <div><span id="mx-d">--</span><p>Días</p></div>
      <div><span id="mx-h">--</span><p>Horas</p></div>
      <div><span id="mx-m">--</span><p>Minutos</p></div>
      <div><span id="mx-s">--</span><p>Segundos</p></div>
    </div>
    <p class="mx-cd-foot">para el día más esperado.</p>
  </section>

  <!-- ============ HISTORIA ============ -->
  <section class="mx-story">
    <div class="mx-story-head" data-animate>
      <p class="mx-pre center">Nuestra historia</p>
      <h2>Cómo terminamos<br/><em>queriéndonos así.</em></h2>
    </div>
    <div class="mx-story-grid">
      <article data-animate>
        <svg viewBox="0 0 100 100" class="mx-flower-mini"><use href="#mx-marigold"/></svg>
        <p class="mx-year">2020</p>
        <h3>Pandemia, Bumble, taquería.</h3>
        <p>Match en marzo. Primera cita en julio cuando reabrieron las taquerías. Primera frase: "no te conozco pero sí sé que pides los tacos al pastor con piña".</p>
      </article>
      <article data-animate>
        <svg viewBox="0 0 100 100" class="mx-flower-mini"><use href="#mx-marigold"/></svg>
        <p class="mx-year">2022</p>
        <h3>Día de muertos en Pátzcuaro.</h3>
        <p>El primer viaje juntos. Vimos pasar la canoa con velas, lloramos un poco, decidimos —en silencio— que esto era para largo.</p>
      </article>
      <article data-animate>
        <svg viewBox="0 0 100 100" class="mx-flower-mini"><use href="#mx-marigold"/></svg>
        <p class="mx-year">2024</p>
        <h3>Mudanza a la Roma.</h3>
        <p>Una azotea, una jardinera, dos perros. La rutina nos sentó bien.</p>
      </article>
      <article data-animate>
        <svg viewBox="0 0 100 100" class="mx-flower-mini"><use href="#mx-marigold"/></svg>
        <p class="mx-year">2026</p>
        <h3>La pedida en SMA.</h3>
        <p>En la rotonda del jardín. Mariachis tocaron "El Rey". Todo el mundo aplaudió. Ella dijo sí entre carcajadas.</p>
      </article>
      <article data-animate>
        <svg viewBox="0 0 100 100" class="mx-flower-mini"><use href="#mx-marigold"/></svg>
        <p class="mx-year">2027</p>
        <h3>El día que decidimos.</h3>
        <p>Hacienda Las Trancas. Tú ahí. Mole en el horno. Cohetes en el cielo.</p>
      </article>
    </div>
  </section>

  <!-- ============ GALERÍA ============ -->
  <section class="mx-gallery" data-animate>
    <p class="mx-pre center">Memorias</p>
    <h2>Álbum del corazón.</h2>
    <div class="mx-gal-grid">
      <figure><img src="https://images.unsplash.com/photo-1518998053901-5348d3961a04?w=900&auto=format&fit=crop&q=80" alt=""/></figure>
      <figure><img src="https://images.unsplash.com/photo-1520637836862-4d197d17c969?w=900&auto=format&fit=crop&q=80" alt=""/></figure>
      <figure><img src="https://images.unsplash.com/photo-1583416750470-965b2707b355?w=900&auto=format&fit=crop&q=80" alt=""/></figure>
      <figure><img src="https://images.unsplash.com/photo-1612366589041-2f6dd33e7f5d?w=900&auto=format&fit=crop&q=80" alt=""/></figure>
      <figure><img src="https://images.unsplash.com/photo-1601128533718-374ffcca299b?w=900&auto=format&fit=crop&q=80" alt=""/></figure>
      <figure><img src="https://images.unsplash.com/photo-1469854523086-cc02fe5d8800?w=900&auto=format&fit=crop&q=80" alt=""/></figure>
    </div>
  </section>

  <!-- ============ ITINERARIO ============ -->
  <section class="mx-program" data-animate>
    <p class="mx-pre center">Programa</p>
    <h2>El día con todo<br/><em>su sabor.</em></h2>
    <div class="mx-program-list">
      <div class="mx-pr-row"><span>16:00</span><div><h4>Misa católica</h4><p>Parroquia de San Miguel Arcángel.</p></div></div>
      <div class="mx-pr-row"><span>17:30</span><div><h4>Coctel mexicano</h4><p>Mezcalitas, micheladas, esquites, tlayudas.</p></div></div>
      <div class="mx-pr-row"><span>19:00</span><div><h4>Cena de gala</h4><p>Banquete de tres tiempos: mole negro de Oaxaca de plato fuerte.</p></div></div>
      <div class="mx-pr-row"><span>21:00</span><div><h4>Mariachi y vals</h4><p>Mariachi Vargas para abrir pista.</p></div></div>
      <div class="mx-pr-row"><span>22:00</span><div><h4>Banda y baile</h4><p>Banda en vivo: cumbia, salsa, perreo.</p></div></div>
      <div class="mx-pr-row"><span>00:00</span><div><h4>Show de pirotecnia</h4><p>Castillo y palomas. Sí, en serio.</p></div></div>
      <div class="mx-pr-row"><span>03:00</span><div><h4>Tornaboda</h4><p>Pozole rojo, café de olla y pan.</p></div></div>
    </div>
  </section>

  <!-- ============ UBICACIONES ============ -->
  <section class="mx-loc">
    <p class="mx-pre center">Locaciones</p>
    <h2 data-animate>Donde te esperamos.</h2>
    <div class="mx-loc-grid">
      <article data-animate>
        <div class="mx-loc-img" style="background-image:url('https://images.unsplash.com/photo-1518998053901-5348d3961a04?w=900&auto=format&fit=crop&q=80')"></div>
        <p class="mx-loc-tag">Misa · 16:00</p>
        <h3>Parroquia de San Miguel Arcángel</h3>
        <p>Plaza Allende s/n, Centro Histórico, San Miguel de Allende, Gto.</p>
        <a href="https://maps.google.com" target="_blank" rel="noopener">Ver mapa →</a>
      </article>
      <article data-animate>
        <div class="mx-loc-img" style="background-image:url('https://images.unsplash.com/photo-1469854523086-cc02fe5d8800?w=900&auto=format&fit=crop&q=80')"></div>
        <p class="mx-loc-tag">Recepción · 17:30</p>
        <h3>Hacienda Las Trancas</h3>
        <p>Camino a Las Trancas Km 7, San Miguel de Allende, Gto.</p>
        <a href="https://maps.google.com" target="_blank" rel="noopener">Ver mapa →</a>
      </article>
    </div>
    <div class="mx-hotels" data-animate>
      <h4>Hospedaje sugerido</h4>
      <ul>
        <li><strong>Rosewood San Miguel</strong> — Tarifa especial $7,800 MXN/noche con código <em>AYM2027</em>.</li>
        <li><strong>Hotel Matilda</strong> — Boutique al centro, $4,200 MXN/noche.</li>
        <li><strong>Casa Linda Hotel</strong> — A 7 min del jardín principal, $2,800 MXN/noche.</li>
        <li><strong>Hotel Posada de las Monjas</strong> — Tradicional y económico, $1,400 MXN/noche.</li>
      </ul>
      <h4 class="mt">Camión organizado</h4>
      <p>Salida CDMX (Polanco) viernes 17 a las 14:00 hrs. Regreso domingo 19 a las 11:00 hrs. Cupo limitado, especifica al confirmar tu asistencia.</p>
    </div>
  </section>

  <!-- ============ DRESS CODE ============ -->
  <section class="mx-dress" data-animate>
    <p class="mx-pre center">Dress code</p>
    <h2>Formal mexicano.</h2>
    <p class="mx-dress-text">
      Color, color y más color. Ellas: vestido largo o midi, bordado mexicano si se animan,
      rebozo si quieren. Ellos: traje en tonos cálidos, guayabera bordada también funciona.
      <em>Reservamos el blanco para la novia, por favor.</em>
    </p>
    <div class="mx-swatches">
      <div><span style="background:#c4631e"></span><p>Naranja</p></div>
      <div><span style="background:#8b1e1e"></span><p>Rojo cardenal</p></div>
      <div><span style="background:#1a8a8a"></span><p>Turquesa</p></div>
      <div><span style="background:#f4a14e"></span><p>Cempasúchil</p></div>
      <div><span style="background:#3d4e2a"></span><p>Verde nopal</p></div>
      <div><span style="background:#e8c75a"></span><p>Maíz</p></div>
    </div>
  </section>

  <!-- ============ NIÑOS ============ -->
  <section class="mx-kids" data-animate>
    <p>👶 Nos encantan tus pequeños y queremos que estén. Habrá área kids con piñatas, animadores y catering infantil. <em>Indícanos cuántos al confirmar.</em></p>
  </section>

  <!-- ============ REGALOS ============ -->
  <section class="mx-gifts" data-animate>
    <p class="mx-pre center">Mesa de regalos</p>
    <h2>Tu compañía es nuestra alegría.</h2>
    <p class="mx-gifts-text">
      Si quieres acompañarnos con un regalo, te dejamos opciones. Cualquier gesto se recibe con cariño.
    </p>
    <div class="mx-gifts-grid">
      <div class="mx-gift">
        <h4>Lluvia de sobres</h4>
        <p>Habrá un cofre tallado en madera de la Sierra Gorda en la entrada con sobres bordados a tu disposición.</p>
      </div>
      <div class="mx-gift">
        <h4>Transferencia</h4>
        <p>Banorte · 0192 7384 5612 9034<br/>CLABE 072180019273845612<br/>Andrés Vargas / Mariana Ramírez</p>
      </div>
      <div class="mx-gift">
        <h4>Mesa Liverpool</h4>
        <p>Evento <em>59023</em> · Búscanos como "Vargas-Ramírez 2027".</p>
      </div>
      <div class="mx-gift">
        <h4>Luna de miel</h4>
        <p>Vamos a Japón en febrero. Cada aporte es un onsen, un sake, un templo en silencio.</p>
      </div>
    </div>
  </section>

  <!-- ============ RSVP ============ -->
  <section class="mx-rsvp" data-animate>
    <p class="mx-pre center">Confirmación</p>
    <h2>¿Vienes?</h2>
    <p class="mx-deadline">Confirma antes del 15 de septiembre de 2027.</p>
    <form id="mx-rsvp-form" novalidate>
      <label><span>Nombre completo</span><input type="text" name="name" required/></label>
      <div class="mx-row">
        <label><span>Asistencia</span><select name="attend"><option>Confirmo</option><option>No podré</option></select></label>
        <label><span>Pase para</span><select name="guests"><option>1 persona</option><option>2 personas</option></select></label>
      </div>
      <label><span>Niños (cuántos)</span><input type="number" name="kids" min="0" max="5" value="0"/></label>
      <label><span>Restricciones alimentarias</span><input type="text" name="diet" placeholder="Vegetariano, sin gluten, alergias..."/></label>
      <label><span>¿Camión desde CDMX?</span><select name="bus"><option>No, voy por mi cuenta</option><option>Sí, ida y vuelta</option><option>Solo ida</option><option>Solo regreso</option></select></label>
      <label><span>Una canción para la pista</span><input type="text" name="song"/></label>
      <button type="submit">¡Confirmar!</button>
      <p id="mx-rsvp-ok" class="mx-rsvp-ok" hidden>¡Recibido! Nos vemos en SMA. 🌼</p>
    </form>
  </section>

  <!-- ============ PLAYLIST ============ -->
  <section class="mx-pl" data-animate>
    <p class="mx-pre center">Lo que sonará</p>
    <h2>Cumbia, salsa<br/><em>y un poco de banda.</em></h2>
    <div class="mx-pl-grid">
      <div><strong>El Rey</strong><em>Vicente Fernández</em></div>
      <div><strong>Cielito Lindo</strong><em>Mariachi Vargas</em></div>
      <div><strong>La Llorona</strong><em>Chavela Vargas</em></div>
      <div><strong>Caminos de Michoacán</strong><em>Vicente Fernández</em></div>
      <div><strong>Bidi Bidi Bom Bom</strong><em>Selena</em></div>
      <div><strong>Vivir Mi Vida</strong><em>Marc Anthony</em></div>
      <div><strong>La Bicicleta</strong><em>Carlos Vives</em></div>
      <div><strong>Provócame</strong><em>Chayanne</em></div>
      <div><strong>Suavemente</strong><em>Elvis Crespo</em></div>
      <div><strong>El Gran Varón</strong><em>Willie Colón</em></div>
    </div>
  </section>

  <!-- ============ HASHTAG ============ -->
  <section class="mx-hash" data-animate>
    <p class="mx-pre center">Etiquétanos</p>
    <h2 class="mx-hash-tag">#AndrésYMarianaSMA2027</h2>
    <p>Sube todas las fotos. Las que salimos llorando, las que salimos bailando, todas.</p>
  </section>

  <!-- ============ CIERRE ============ -->
  <section class="mx-end">
    <svg class="mx-papel-end-top" viewBox="0 0 1200 100" preserveAspectRatio="none"><use href="#mx-banner"/></svg>
    <div class="mx-end-inner" data-animate>
      <svg class="mx-end-flower" viewBox="0 0 100 100"><use href="#mx-marigold"/></svg>
      <p class="mx-script">¡Vivan los novios!</p>
      <h2>Te esperamos<br/><em>con los brazos abiertos.</em></h2>
      <p class="mx-end-sig">Andrés Vargas · Mariana Ramírez</p>
      <p class="mx-end-date">Octubre · 2027 · San Miguel</p>
    </div>
  </section>

  <style is:global>
    .mex-body {
      background: #f5e8d0;
      color: #3a2818;
      font-family: 'Inter', system-ui, sans-serif;
      font-weight: 400;
    }
    .mex-body h1, .mex-body h2 {
      font-family: 'Abril Fatface', serif;
      font-weight: 400;
      color: #8b1e1e;
      letter-spacing: 0.005em;
    }
    .mex-body h3, .mex-body h4 {
