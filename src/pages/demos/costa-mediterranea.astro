    .bh-tl-items p { font-family: 'Cormorant Infant', serif; font-size: 17px; line-height: 1.6; color: #4a5258; margin: 0; }

    /* GALLERY */
    .bh-gallery { padding: 100px 24px; max-width: 1280px; margin: 0 auto; }
    .bh-gal-head { text-align: center; margin-bottom: 48px; }
    .bh-gal-head h2 { font-size: clamp(36px, 5vw, 60px); margin: 0; }
    .bh-gal-grid { display: grid; gap: 32px; grid-template-columns: repeat(2, 1fr); }
