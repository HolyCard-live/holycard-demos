    /* STORY */
    .bh-story { padding: 100px 24px; max-width: 1000px; margin: 0 auto; position: relative; }
    .bh-story-head h2 { font-size: clamp(36px, 5vw, 60px); margin: 0 0 56px; line-height: 1.1; }
    .bh-tl { position: relative; }
    .bh-tl-line { position: absolute; left: 14px; top: 0; bottom: 0; width: 20px; }
    .bh-tl-line svg { width: 100%; height: 100%; }
    .bh-tl-items { padding-left: 56px; display: grid; gap: 48px; }
    .bh-tl-items article { position: relative; }
    .bh-tl-items article::before {
      content: '';
      position: absolute;
      left: -52px; top: 6px;
      width: 18px; height: 18px;
      border-radius: 50%;
      background: #c8654a;
