    .bh-gal-grid figure:hover img { transform: scale(1.05); }
    .blob-1 { border-radius: 60% 40% 30% 70% / 60% 30% 70% 40%; }
    .blob-2 { border-radius: 30% 70% 70% 30% / 50% 60% 40% 50%; }
    .blob-3 { border-radius: 50% 50% 70% 30% / 40% 60% 30% 70%; }

    /* PROGRAM */
    .bh-program { padding: 100px 24px; max-width: 800px; margin: 0 auto; text-align: center; }
    .bh-program h2 { font-size: clamp(36px, 5vw, 56px); margin: 0 0 56px; }
    .bh-program-list { display: grid; gap: 20px; text-align: left; }
    .bh-program-list > div {
      display: grid; grid-template-columns: 80px 1fr; gap: 24px;
      padding: 20px 24px;
      background: #fff;
      border-radius: 16px;
      box-shadow: 0 6px 24px rgba(45,58,63,0.06);
    }
    .bh-program-list span { font-family: 'Cormorant Infant', serif; font-size: 24px; color: #c8654a; align-self: center; }
    .bh-program-list h4 { margin: 0 0 4px; font-size: 19px; }
    .bh-program-list p { font-family: 'Cormorant Infant', serif; font-size: 15px; color: #4a5258; margin: 0; }

    /* LOC */
    .bh-loc { padding: 100px 24px; max-width: 1100px; margin: 0 auto; text-align: center; }
    .bh-loc h2 { font-size: clamp(36px, 5vw, 56px); margin: 0 0 56px; }
    .bh-loc-grid { display: grid; gap: 24px; text-align: left; }
    @media (min-width: 640px) { .bh-loc-grid { grid-template-columns: repeat(2, 1fr); } }
    .bh-loc-grid article { background: #fff; overflow: hidden; border-radius: 20px; box-shadow: 0 8px 28px rgba(45,58,63,0.08); }
    .bh-loc-img { width: 100%; height: 220px; background-size: cover; background-position: center; }
    .bh-loc-grid article > * { padding-left: 24px; padding-right: 24px; }
    .bh-loc-tag { font-size: 11px; letter-spacing: 0.32em; text-transform: uppercase; color: #c8654a; margin: 20px 0 8px; }
    .bh-loc-grid h3 { font-size: 26px; margin: 0 0 8px; }
    .bh-loc-grid > article > p { font-family: 'Cormorant Infant', serif; font-size: 16px; color: #4a5258; margin: 0 0 16px; }
    .bh-loc-grid a { display: inline-block; color: #c8654a; font-size: 11px; letter-spacing: 0.24em; text-transform: uppercase; border-bottom: 1px solid #c8654a; padding-bottom: 4px; margin-bottom: 24px; text-decoration: none; }
    .bh-hotels { margin-top: 48px; padding: 32px; background: #fff; border-radius: 20px; text-align: left; box-shadow: 0 6px 24px rgba(45,58,63,0.06); }
    .bh-hotels h4 { margin: 0 0 16px; font-size: 22px; color: #3d6b7c; }
    .bh-hotels ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; }
    .bh-hotels li { font-family: 'Cormorant Infant', serif; font-size: 17px; color: #4a5258; }
    .bh-hotels strong { color: #2d3a3f; }
    .bh-hotels em { color: #c8654a; font-style: normal; letter-spacing: 0.1em; }

    /* DRESS */
    .bh-dress { padding: 100px 24px; max-width: 800px; margin: 0 auto; text-align: center; }
    .bh-dress h2 { font-size: clamp(32px, 4vw, 48px); margin: 0 0 24px; }
    .bh-dress-text { font-family: 'Cormorant Infant', serif; font-size: 18px; line-height: 1.7; color: #4a5258; margin: 0 0 40px; }
    .bh-swatches { display: flex; justify-content: center; gap: 20px; flex-wrap: wrap; }
    .bh-swatches > div { text-align: center; }
    .bh-swatches span { display: block; width: 56px; height: 56px; border-radius: 50%; }
    .bh-swatches p { margin: 12px 0 0; font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase; color: #2d3a3f; }
    .bh-dress-no { font-family: 'Caveat', cursive; font-size: 22px; color: #c8654a; margin-top: 32px; }

    /* GIFTS */
    .bh-gifts { padding: 100px 24px; max-width: 1100px; margin: 0 auto; text-align: center; }
    .bh-gifts h2 { font-size: clamp(32px, 4.5vw, 52px); margin: 0 0 56px; }
    .bh-gifts-cards { display: grid; gap: 20px; text-align: left; }
    @media (min-width: 640px) { .bh-gifts-cards { grid-template-columns: repeat(2, 1fr); } }
    .bh-gift-card { padding: 28px; background: #fff; border-radius: 16px; box-shadow: 0 6px 24px rgba(45,58,63,0.06); }
    .bh-gift-card h4 { margin: 0 0 12px; font-size: 20px; color: #c8654a; }
    .bh-gift-card p { font-family: 'Cormorant Infant', serif; font-size: 17px; line-height: 1.6; color: #4a5258; margin: 0; }
    .bh-gift-card em { color: #3d6b7c; font-style: normal; }

    /* RSVP */
    .bh-rsvp { padding: 100px 24px; max-width: 640px; margin: 0 auto; text-align: center; }
    .bh-rsvp h2 { font-size: clamp(40px, 6vw, 64px); margin: 0 0 12px; }
    .bh-rsvp-deadline { font-family: 'Caveat', cursive; font-size: 22px; color: #c8654a; margin: 0 0 40px; }
    #bh-rsvp-form { display: grid; gap: 16px; text-align: left; }
    #bh-rsvp-form label { display: grid; gap: 6px; }
    #bh-rsvp-form span { font-size: 11px; letter-spacing: 0.24em; text-transform: uppercase; color: #c8654a; }
    #bh-rsvp-form input, #bh-rsvp-form select {
      background: #fff;
      border: 1px solid rgba(200,101,74,0.25);
      border-radius: 12px;
      padding: 14px 16px;
      font-size: 16px;
      font-family: 'Outfit', sans-serif;
      color: #2d3a3f;
      outline: none;
      transition: border-color 0.2s ease;
    }
    #bh-rsvp-form input:focus, #bh-rsvp-form select:focus { border-color: #c8654a; }
    .bh-rsvp-row { display: grid; grid-template-columns: 1fr 110px; gap: 12px; }
    #bh-rsvp-form button {
      margin-top: 16px;
      background: #c8654a;
      color: #faf3e8;
      border: none;
      border-radius: 999px;
      padding: 14px 24px;
      font-size: 12px;
      letter-spacing: 0.28em;
      text-transform: uppercase;
      font-weight: 500;
    }
    .bh-rsvp-ok { font-family: 'Caveat', cursive; font-size: 24px; color: #3d6b7c; text-align: center; margin-top: 16px; }

    /* PLAYLIST */
    .bh-pl { padding: 100px 24px; max-width: 900px; margin: 0 auto; text-align: center; }
    .bh-pl h2 { font-size: clamp(32px, 4vw, 48px); margin: 0 0 40px; }
    .bh-pl-grid { display: grid; gap: 14px; grid-template-columns: 1fr; text-align: left; }
    @media (min-width: 640px) { .bh-pl-grid { grid-template-columns: 1fr 1fr; } }
    .bh-pl-grid > div {
      background: #fff;
      border-radius: 12px;
      padding: 16px 20px;
      box-shadow: 0 4px 16px rgba(45,58,63,0.05);
    }
    .bh-pl-grid strong { display: block; font-size: 16px; color: #2d3a3f; }
    .bh-pl-grid em { font-family: 'Cormorant Infant', serif; font-style: italic; font-size: 14px; color: #c8654a; }

    /* HASH */
    .bh-hash { padding: 100px 24px; text-align: center; max-width: 720px; margin: 0 auto; }
    .bh-hash-tag { font-family: 'Caveat', cursive !important; font-size: clamp(36px, 7vw, 64px); color: #c8654a; margin: 16px 0 24px; word-break: break-word; }
    .bh-hash p { font-family: 'Cormorant Infant', serif; font-size: 18px; color: #4a5258; margin: 0; }

    /* END */
    .bh-end { position: relative; padding-top: 100px; padding-bottom: 80px; background: #c8654a; color: #faf3e8; text-align: center; }
    .bh-end-wave { position: absolute; top: -1px; left: 0; width: 100%; height: 80px; transform: rotate(180deg); }
    .bh-end-inner { padding: 60px 24px; }
    .bh-end-inner .bh-script { font-size: 56px; color: #faf3e8; margin: 0 0 16px; }
    .bh-end h2 { font-size: clamp(48px, 8vw, 96px); margin: 0 0 32px; color: #faf3e8; }
    .bh-end-sig { font-family: 'Cormorant Infant', serif; font-style: italic; font-size: 19px; opacity: 0.85; margin: 0; }
  </style>

  <script>
    import gsap from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    gsap.registerPlugin(ScrollTrigger);

    const splash = document.getElementById('bh-splash');
    const cta = document.getElementById('bh-cta');
    if (splash) {
      document.body.style.overflow = 'hidden';
      const dismiss = () => {
        gsap.to(splash, { opacity: 0, duration: 0.7, ease: 'power2.in', onComplete: () => {
          splash.style.display = 'none';
          document.body.style.overflow = '';
        }});
      };
      cta?.addEventListener('click', dismiss);
    }

    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
      }
    }, { threshold: 0.12 });
    document.querySelectorAll('[data-animate]').forEach(el => io.observe(el));

    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const heroImg = document.querySelector<HTMLImageElement>('.bh-hero img');
      if (heroImg) gsap.to(heroImg, { yPercent: 15, ease: 'none', scrollTrigger: { trigger: '.bh-hero', start: 'top top', end: 'bottom top', scrub: true } });
    }

    const target = new Date('2027-06-06T17:30:00-05:00').getTime();
    const tick = () => {
      const diff = target - Date.now();
      if (diff <= 0) return;
      const set = (id: string, v: number) => { const el = document.getElementById(id); if (el) el.textContent = String(v).padStart(2, '0'); };
      set('bh-d', Math.floor(diff / 86400000));
      set('bh-h', Math.floor((diff / 3600000) % 24));
      set('bh-m', Math.floor((diff / 60000) % 60));
      set('bh-s', Math.floor((diff / 1000) % 60));
    };
    tick(); setInterval(tick, 1000);

    const form = document.getElementById('bh-rsvp-form');
    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      document.getElementById('bh-rsvp-ok')?.removeAttribute('hidden');
      (form as HTMLFormElement).reset();
    });
  </script>
</DemoLayout>
