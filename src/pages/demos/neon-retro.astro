    .nr-end-inner { position: relative; z-index: 5; max-width: 720px; margin: 0 auto; }
    .nr-end h2 { font-size: clamp(48px, 9vw, 120px); line-height: 1; margin: 16px 0 32px; }
    .nr-end-sig { font-family: 'VT323', monospace; font-size: 20px; color: #00f5ff; letter-spacing: 0.18em; margin: 0; }
  </style>

  <script>
    import gsap from 'gsap';

    // Stars in splash
    const stars = document.getElementById('nr-stars');
    if (stars) {
      for (let i = 0; i < 60; i++) {
        const s = document.createElement('span');
        s.style.left = Math.random() * 100 + '%';
        s.style.top = Math.random() * 100 + '%';
        s.style.animationDelay = (Math.random() * 3) + 's';
        stars.appendChild(s);
      }
    }

    const splash = document.getElementById('nr-splash');
    const cta = document.getElementById('nr-cta');
    if (splash) {
      document.body.style.overflow = 'hidden';
      const dismiss = () => {
        gsap.to(splash, { opacity: 0, duration: 0.6, ease: 'power2.in', onComplete: () => {
          splash.style.display = 'none';
          document.body.style.overflow = '';
        }});
      };
      cta?.addEventListener('click', dismiss);
    }

    const io = new IntersectionObserver((entries) => {
      for (const e of entries) if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
    }, { threshold: 0.12 });
    document.querySelectorAll('[data-animate]').forEach(el => io.observe(el));

    const target = new Date('2027-08-08T20:00:00-07:00').getTime();
    const tick = () => {
      const diff = target - Date.now();
      if (diff <= 0) return;
      const set = (id: string, v: number) => { const el = document.getElementById(id); if (el) el.textContent = String(v).padStart(2, '0'); };
      set('nr-d', Math.floor(diff / 86400000));
      set('nr-h', Math.floor((diff / 3600000) % 24));
      set('nr-m', Math.floor((diff / 60000) % 60));
      set('nr-s', Math.floor((diff / 1000) % 60));
    };
    tick(); setInterval(tick, 1000);

    const form = document.getElementById('nr-rsvp-form');
    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      document.getElementById('nr-rsvp-ok')?.removeAttribute('hidden');
      (form as HTMLFormElement).reset();
    });
  </script>
</DemoLayout>
