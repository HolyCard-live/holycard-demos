    .nr-gifts-intro { font-family: 'Space Grotesk', sans-serif; font-size: 17px; color: #d8d8d8; max-width: 640px; margin: 0 auto 48px; }
    .nr-gifts-grid { display: grid; gap: 16px; text-align: left; }
