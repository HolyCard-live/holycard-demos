    .nr-swatches { display: flex; justify-content: center; gap: 18px; flex-wrap: wrap; }
    .nr-swatches > div { text-align: center; }
    .nr-swatches span { display: block; width: 56px; height: 56px; border-radius: 50%; border: 2px solid rgba(255,255,255,0.3); box-shadow: 0 0 16px currentColor; }
