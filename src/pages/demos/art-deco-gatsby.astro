    .dc-gifts-intro { font-family: 'Cormorant Garamond', serif; font-size: 18px; color: rgba(245,232,208,0.85); max-width: 640px; margin: 0 auto 48px; }
    .dc-gifts-grid { display: grid; gap: 20px; text-align: left; }
