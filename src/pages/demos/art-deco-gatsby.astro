    .dc-end-inner { position: relative; max-width: 720px; margin: 0 auto; }
    .dc-end h2 { font-size: clamp(36px, 6vw, 72px); margin: 0 0 32px; line-height: 1.15; }
    .dc-end-sig { font-family: 'Cormorant Garamond', serif; font-style: italic; font-size: 19px; color: #d4af37; margin: 0 0 8px; }
    .dc-end-date { font-family: 'Poiret One', sans-serif; font-size: 11px; letter-spacing: 0.4em; text-transform: uppercase; color: rgba(245,232,208,0.6); margin: 0; }
  </style>

  <script>
    import gsap from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    gsap.registerPlugin(ScrollTrigger);

    const splash = document.getElementById('dc-splash');
    const cta = document.getElementById('dc-cta');
    if (splash) {
      document.body.style.overflow = 'hidden';
      const dismiss = () => {
        gsap.to(splash, { opacity: 0, duration: 0.7, ease: 'power2.in', onComplete: () => {
          splash.style.display = 'none';
          document.body.style.overflow = '';
        }});
      };
      cta?.addEventListener('click', dismiss);
    }

    const io = new IntersectionObserver((entries) => {
      for (const e of entries) if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
    }, { threshold: 0.12 });
    document.querySelectorAll('[data-animate]').forEach(el => io.observe(el));

    const target = new Date('2027-11-13T19:00:00-06:00').getTime();
    const tick = () => {
      const diff = target - Date.now();
      if (diff <= 0) return;
      const set = (id: string, v: number) => { const el = document.getElementById(id); if (el) el.textContent = String(v).padStart(2, '0'); };
      set('dc-d', Math.floor(diff / 86400000));
      set('dc-h', Math.floor((diff / 3600000) % 24));
      set('dc-m', Math.floor((diff / 60000) % 60));
      set('dc-s', Math.floor((diff / 1000) % 60));
    };
    tick(); setInterval(tick, 1000);

    const form = document.getElementById('dc-rsvp-form');
    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      document.getElementById('dc-rsvp-ok')?.removeAttribute('hidden');
      (form as HTMLFormElement).reset();
    });
  </script>
</DemoLayout>
